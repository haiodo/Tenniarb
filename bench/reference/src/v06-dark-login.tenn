element "Screen" {
	item Card {
		auto-layout column; gap 16; padding 32; width 360; height 420; color #1e1b29; corner-radius 16; clip yes
		item Title { title "Welcome back"; font-size 28; line-height 34; font-family "IBM Plex Sans"; font-weight 700; text-color #f4f1ff }
		item Subtitle { title "Sign in to continue to Acme."; font-size 14; line-height 20; font-family "IBM Plex Sans"; text-color #a9a4bd }
		item Email {
			auto-layout column; gap 6; width fill
			item Label { title Email; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #a9a4bd }
			item Box {
				auto-layout row; align center; padding 0 12; width fill; height 44; corner-radius 8; color #2a2638; border-color #3a3548
				item Value { title "demo@example.com"; font-size 14; font-family "IBM Plex Sans"; text-color #f4f1ff }
			}
		}
		item Password {
			auto-layout column; gap 6; width fill
			item Label { title Password; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #a9a4bd }
			item Box {
				auto-layout row; align center; padding 0 12; width fill; height 44; corner-radius 8; color #2a2638; border-color #3a3548
				item Value { title "••••••••"; font-size 14; font-family "IBM Plex Sans"; text-color #f4f1ff }
			}
		}
		item SignIn {
			auto-layout row; align center; justify center; width fill; height 44; corner-radius 8; color #8b5cf6
			item Label { title "Sign in"; font-size 14; font-family "IBM Plex Sans"; font-weight 600; text-color #ffffff }
		}
		item Forgot { title "Forgot password?"; font-size 13; line-height 18; font-family "IBM Plex Sans"; text-color #b9a2f7 }
		item Footer { title "No account? Create one"; font-size 13; line-height 18; font-family "IBM Plex Sans"; text-color #a9a4bd }
	}
}
