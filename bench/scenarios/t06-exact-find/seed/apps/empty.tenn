element "Empty" {
	item Row {
		auto-layout column; gap 12; padding 16; width 400; color #f7f8fa
		item Card1 {
			auto-layout column; gap 8; padding 12; width 360; color #ffffff; border-color #e5e7eb; corner-radius 8
			item Title { title Same; font-size 16; font-weight 600 }
		}
		item Card2 {
			auto-layout column; gap 8; padding 12; width 360; color #ffffff; border-color #e5e7eb; corner-radius 8
			item Title { title Same; font-size 16; font-weight 600 }
		}
	}
}
