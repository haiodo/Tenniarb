entry "../PlatformDesign.tenn"

item Field {
	export let label = Label
	export let value = Value
	auto-layout column; gap 6; width 320
	item Label { title ${label}; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #6b7280 }
	item Box {
		auto-layout row; align center; padding 0 12; height 40; corner-radius 8; color #ffffff; border-color #d9dee6
		item Value { title ${value}; font-size 14; font-family "IBM Plex Sans"; text-color #201240; layout left }
	}
}

item Dialog {
	export let title = Dialog
	export let body = ""
	auto-layout column; gap 16; padding 24; width 480; corner-radius 12; color #ffffff; shadow 0 -8 24
	item Title { title ${title}; font-size 18; font-weight 700; font-family "IBM Plex Sans" }
	item Body { title ${body}; font-size 14; line-height 20; font-family "IBM Plex Sans"; text-color #333333; layout left }
}
