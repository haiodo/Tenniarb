// Prototype: one Button component, every catalogue variant a named style (spec 5b), and the
// instance picks the variant by parameter (spec 5c):
//     use Button as save { title "Save"; kind primary; size large }
// Review only, nothing generated uses it yet. A block sits on its own line: two blocks on one line
// are one command, so the second name would be lost.
element "Button" kind Component {
    export let title = "Button"
    export let kind = secondary
    export let size = medium
    export let shape = with-icon

    styles {
        // kind: the box; the text inside takes its colour (the contrast of the fill, or text-color here),
        // and the icon of the catalogue is drawn by stroke, so it keeps its own border-color
        primary {
            color #6b3ad3; border-color #1725471a
            Icon { border-color #ffffff }
        }
        secondary {
            color #1725470d; border-color #1725471a; text-color #0f121a
            Icon { border-color #000000 }
        }
        tertiary {
            color none; border-color none; text-color #6b3ad3
            Icon { border-color #6b3ad3 }
        }
        ghost {
            color none; border-color none; text-color #0f121a
            Icon { border-color #5a667e }
        }
        negative {
            color #cb4b42; border-color #d1d5de26
            Icon { border-color #ffffff }
        }
        brand {
            color #cf13a2; border-color none
            Icon { border-color #ffffff }
        }

        // size: the box, and the icon-only width as the same number
        large {
            height 48; min-width 48; gap 8; padding 0 16; corner-radius 8
        }
        medium {
            height 40; min-width 40; gap 8; padding 0 16; corner-radius 8
        }
        small {
            height 32; min-width 32; gap 4; padding 0 8; corner-radius 6
        }
        extra-small {
            height 24; min-width 24; gap 4; padding 0 8; corner-radius 4
        }

        // shape: which parts are drawn; "with-icon" is the neutral member of the group
        with-icon { }
        icon-only {
            padding 0
            Label { hidden yes }
        }
        no-icon {
            Icon { hidden yes }
        }

        // state
        disabled {
            color #f0f0f2; border-color #0000000f
            Label { text-color #00000066 }
            Icon { border-color #00000066 }
        }

        kind one-of primary secondary tertiary ghost negative brand
        size one-of large medium small extra-small
        shape one-of with-icon icon-only no-icon
        state any-of disabled
    }
    item Btn {
        auto-layout row; gap 8; padding 0 16; align center; justify center; clip yes; corner-radius 8
        use-style ${kind} ${size} ${shape}
        item Icon {
            width 16; height 16; path "M8 3v10M3 8h10"; view-box 0 0 16 16; line-width 1.3
        }
        item Label {
            title ${title}; font-size 14; line-height 16; font-family "IBM Plex Sans"; font-weight 500; layout left
        }
    }
}

element "Screen" {
    // the root of an element is placed absolutely, so the column needs one item around it
    item canvas {
        auto-layout column; gap 24; padding 32; color #ffffff
        item "row primary" {
            auto-layout row; gap 16; align center
            item cap { title primary; width 88; font-size 12; line-height 16; text-color #5a667e }
            use Button as "primary/large" { kind primary; size large }
            use Button as "primary/medium" { kind primary; size medium }
            use Button as "primary/small" { kind primary; size small }
            use Button as "primary/extra-small" { kind primary; size extra-small }
            use Button as "primary/large/icon" { kind primary; size large; shape icon-only }
            use Button as "primary/medium/icon" { kind primary; size medium; shape icon-only }
            use Button as "primary/small/icon" { kind primary; size small; shape icon-only }
            use Button as "primary/extra-small/icon" { kind primary; size extra-small; shape icon-only }
        }
        item "row secondary" {
            auto-layout row; gap 16; align center
            item cap { title secondary; width 88; font-size 12; line-height 16; text-color #5a667e }
            use Button as "secondary/large" { kind secondary; size large }
            use Button as "secondary/medium" { kind secondary; size medium }
            use Button as "secondary/small" { kind secondary; size small }
            use Button as "secondary/extra-small" { kind secondary; size extra-small }
            use Button as "secondary/large/icon" { kind secondary; size large; shape icon-only }
            use Button as "secondary/medium/icon" { kind secondary; size medium; shape icon-only }
            use Button as "secondary/small/icon" { kind secondary; size small; shape icon-only }
            use Button as "secondary/extra-small/icon" { kind secondary; size extra-small; shape icon-only }
        }
        item "row tertiary" {
            auto-layout row; gap 16; align center
            item cap { title tertiary; width 88; font-size 12; line-height 16; text-color #5a667e }
            use Button as "tertiary/large" { kind tertiary; size large }
            use Button as "tertiary/medium" { kind tertiary; size medium }
            use Button as "tertiary/small" { kind tertiary; size small }
            use Button as "tertiary/extra-small" { kind tertiary; size extra-small }
            use Button as "tertiary/large/icon" { kind tertiary; size large; shape icon-only }
            use Button as "tertiary/medium/icon" { kind tertiary; size medium; shape icon-only }
            use Button as "tertiary/small/icon" { kind tertiary; size small; shape icon-only }
            use Button as "tertiary/extra-small/icon" { kind tertiary; size extra-small; shape icon-only }
        }
        item "row ghost" {
            auto-layout row; gap 16; align center
            item cap { title ghost; width 88; font-size 12; line-height 16; text-color #5a667e }
            use Button as "ghost/large" { kind ghost; size large }
            use Button as "ghost/medium" { kind ghost; size medium }
            use Button as "ghost/small" { kind ghost; size small }
            use Button as "ghost/extra-small" { kind ghost; size extra-small }
            use Button as "ghost/large/icon" { kind ghost; size large; shape icon-only }
            use Button as "ghost/medium/icon" { kind ghost; size medium; shape icon-only }
            use Button as "ghost/small/icon" { kind ghost; size small; shape icon-only }
            use Button as "ghost/extra-small/icon" { kind ghost; size extra-small; shape icon-only }
        }
        item "row negative" {
            auto-layout row; gap 16; align center
            item cap { title negative; width 88; font-size 12; line-height 16; text-color #5a667e }
            use Button as "negative/large" { kind negative; size large }
            use Button as "negative/medium" { kind negative; size medium }
            use Button as "negative/small" { kind negative; size small }
            use Button as "negative/extra-small" { kind negative; size extra-small }
            use Button as "negative/large/icon" { kind negative; size large; shape icon-only }
            use Button as "negative/medium/icon" { kind negative; size medium; shape icon-only }
            use Button as "negative/small/icon" { kind negative; size small; shape icon-only }
            use Button as "negative/extra-small/icon" { kind negative; size extra-small; shape icon-only }
        }
        item "row brand" {
            auto-layout row; gap 16; align center
            item cap { title brand; width 88; font-size 12; line-height 16; text-color #5a667e }
            use Button as "brand/large" { kind brand; size large }
            use Button as "brand/medium" { kind brand; size medium }
            use Button as "brand/small" { kind brand; size small }
            use Button as "brand/extra-small" { kind brand; size extra-small }
            use Button as "brand/large/icon" { kind brand; size large; shape icon-only }
            use Button as "brand/medium/icon" { kind brand; size medium; shape icon-only }
            use Button as "brand/small/icon" { kind brand; size small; shape icon-only }
            use Button as "brand/extra-small/icon" { kind brand; size extra-small; shape icon-only }
        }
        item "row shape" {
            auto-layout row; gap 16; align center
            item cap { title shape; width 88; font-size 12; line-height 16; text-color #5a667e }
            use Button as "shape/with icon" { kind primary; size large }
            use Button as "shape/icon only" { kind primary; size large; shape icon-only }
            use Button as "shape/no icon" { kind primary; size large; shape no-icon }
            use Button as "shape/other icon" { kind primary; size large; title More
                at Btn.Icon { path "M3.5 6L8 10.5 12.5 6" }
            }
        }
        item "row disabled" {
            auto-layout row; gap 16; align center
            item cap { title disabled; width 88; font-size 12; line-height 16; text-color #5a667e }
            use Button as "disabled/primary" { kind primary; size large; at Btn { use-style disabled } }
            use Button as "disabled/secondary" { kind secondary; size large; at Btn { use-style disabled } }
            use Button as "disabled/tertiary" { kind tertiary; size large; at Btn { use-style disabled } }
            use Button as "disabled/ghost" { kind ghost; size large; at Btn { use-style disabled } }
            use Button as "disabled/negative" { kind negative; size large; at Btn { use-style disabled } }
            use Button as "disabled/brand" { kind brand; size large; at Btn { use-style disabled } }
        }
    }
}
