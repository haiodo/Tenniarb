entry "../PlatformDesign.tenn"
context --from-item Light

item RoomTile {
	export let name = "Планёрка"; export let rtype = video; export let info = "В эфире 12:34"; export let live = true; export let locked = false; export let a1 = true; export let a2 = true; export let a3 = false; export let more = true; export let extra = "+1"
	auto-layout column; gap 8; width 240; height 170; padding 12; clip yes; color ${ctx.card}; corner-radius 12; border-color ${ctx.borderCard}; line-width 1
	item header {
		auto-layout row; gap 8; align center; width 216
		use Libraries.ui_kit.Icon.kit_Camera as "icon/video" { width 16; height 16; color #6b3ad3; hidden ${rtype !== "video"} }
		use Libraries.ui_kit.Icon.kit_Mic as "icon/audio" { width 16; height 16; color #6b3ad3; hidden ${rtype !== "audio"} }
		item rname { title ${name}; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color ${ctx.ink} }
		use Libraries.ui_kit.Icon.kit_Key as "icon/lock" { width 14; height 14; color ${ctx.inkHint}; hidden ${locked !== "true"} }
		use Libraries.ui_kit.Icon.kit_DotsHorizontal as "icon/more" { width 16; height 16; color ${ctx.ink60} }
	}
	item people {
		auto-layout row; gap 4; align center; width 216; height 32
		item a1 { auto-layout row; align center; justify center; width 28; height 28; clip yes; color #925cb1; corner-radius 7; hidden ${a1 !== "true"}; item i1 { title AS; font-size 12; line-height 14; font-family "IBM Plex Sans"; font-weight 500; text-color #ffffff } }
		item a2 { auto-layout row; align center; justify center; width 28; height 28; clip yes; color #758595; corner-radius 7; hidden ${a2 !== "true"}; item i2 { title CM; font-size 12; line-height 14; font-family "IBM Plex Sans"; font-weight 500; text-color #ffffff } }
		item a3 { auto-layout row; align center; justify center; width 28; height 28; clip yes; color #dc85f5; corner-radius 7; hidden ${a3 !== "true"}; item i3 { title PI; font-size 12; line-height 14; font-family "IBM Plex Sans"; font-weight 500; text-color #ffffff } }
		item more { title ${extra}; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color ${ctx.inkHint}; hidden ${more !== "true"} }
	}
	item footer {
		auto-layout row; gap 6; align center; width 216
		item dot { width 8; height 8; clip yes; color ${live === "true" ? "#05a05c" : "#c4c9d4"}; corner-radius 4 }
		item state { title ${info}; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color ${ctx.ink60} }
	}
}

element "Meetings" {
	element "Этаж" {
		use Libraries.workbench.Workbench as "Floor screen" {
			pos 0 0
			replace Top_bar {
				use Libraries.workbench.TopBar as "Top bar" {
					replace tabs.tab.icon_kit_CheckSquare {
						use Libraries.ui_kit.Icon.kit_Building as "icon/kit/Building" { width 12; height 12; color #000000cc }
					}
					at tabs.tab.Tracker { title Office }
				}
			}
			replace App_rail {
				use Libraries.workbench.AppRail as "App rail" {
					pos 0 -36
					at AppItem_kit_Building { color #e6e6e6; border-color #00000017; line-width 1 }
					at AppItem_kit_Building.icon_kit_Building { color #000000 }
				}
			}
			replace _Navigator {
				use Libraries.workbench.Navigator_tools as Navigator {
					pos 68 -36
					at Chat { title Office }
					slot items {
						use Libraries.workbench.NavCaption as "NavCaption Этажи" {
							pos 16 -56
							at icon_kit_CaretDownFill { hidden no }
							at Channels { title FLOORS }
						}
						use Libraries.workbench.NavItem as "NavItem/Этаж 1" {
							selected true; padding 0 8 0 32; pos 13 -88
							replace icon_kit_CheckSquare {
								use Libraries.ui_kit.Icon.kit_Building as "icon/kit/Building" { color #0f121a }
							}
							at Issues { title "Этаж 1" }
						}
						use Libraries.workbench.NavItem as "NavItem/Этаж 2" { padding 0 8 0 32; pos 13 -120; at Issues { title "Этаж 2" } }
						item divider { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -156 }
						use Libraries.workbench.NavCaption as "NavCaption Встречи" {
							pos 16 -182
							at icon_kit_CaretDownFill { hidden no }
							at Channels { title MEETINGS }
						}
						use Libraries.workbench.NavItem as "NavItem/Сегодня" {
							padding 0 8 0 32; pos 13 -214
							replace icon_kit_CheckSquare {
								use Libraries.ui_kit.Icon.kit_Calendar as "icon/kit/Calendar" { color #0f121a }
							}
							at Issues { title Сегодня }
						}
						use Libraries.workbench.NavItem as "NavItem/Записи" {
							padding 0 8 0 32; pos 13 -246
							replace icon_kit_CheckSquare {
								use Libraries.ui_kit.Icon.kit_Clipboard as "icon/kit/Clipboard" { color #0f121a }
							}
							at Issues { title Записи }
						}
						item "footer line" { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -282 }
					}
				}
			}
			slot Main_panel {
				item floor_header {
				auto-layout row; gap 12; align center; width 1467; height 48; padding 0 8; pos 24 0
				item floor_title { title "Этаж 1"; width fill; font-size 20; line-height 24; font-family "IBM Plex Sans"; font-weight 700; layout left; text-color #0f121a }
				use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/medium" {
					kind ghost; size medium; shape icon
					replace icon_kit_PencilLine {
						use Libraries.ui_kit.Icon.kit_Gear as "icon/kit/Gear" { color #00000099 }
					}
				}
				use Libraries.ui_kit.Actions.Button as "Button/new-room" {
					label Комната
				}
			}
			item rooms {
				auto-layout abs; width 1467; height 560; clip yes; color #eef0f4; corner-radius 12; pos 24 -68
				item room1 {
					auto-layout column; gap 10; padding 12; width 432; height 512; clip yes; color #ffffff; border-color #00000014; corner-radius 8; pos 24 -24
					item header {
						auto-layout row; gap 8; align center; width fill
						use Libraries.ui_kit.Icon.kit_Camera as "icon/video" { width 16; height 16; color #6b3ad3 }
						item rname { title Планёрка; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #0f121a }
						use Libraries.ui_kit.Icon.kit_DotsHorizontal as "icon/more" { width 16; height 16; color #00000099 }
					}
					item people {
						auto-layout row; gap 8; wrap yes; line-gap 8; width fill
						item p1 { auto-layout row; align center; justify center; width 40; height 40; clip yes; color #925cb1; corner-radius 20; item i1 { title AS; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 500; text-color #ffffff } }
						item p2 { auto-layout row; align center; justify center; width 40; height 40; clip yes; color #758595; corner-radius 20; item i2 { title CM; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 500; text-color #ffffff } }
						item p3 { auto-layout row; align center; justify center; width 40; height 40; clip yes; color #dc85f5; corner-radius 20; item i3 { title PI; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 500; text-color #ffffff } }
						item p4 { auto-layout row; align center; justify center; width 40; height 40; clip yes; color #4d7fd1; corner-radius 20; item i4 { title AJ; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 500; text-color #ffffff } }
						item more { title "+2"; font-size 13; line-height 16; font-family "IBM Plex Sans"; text-color #7f7f7f }
					}
					item grow { height fill }
					item footer {
						auto-layout row; gap 6; align center; width fill
						item dot { width 8; height 8; clip yes; color #05a05c; corner-radius 4 }
						item state { title "В эфире 12:34"; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #00000099 }
					}
				}
				item room2 {
					auto-layout column; gap 10; padding 12; width 336; height 512; clip yes; color #ffffff; border-color #00000014; corner-radius 8; pos 480 -24
					item header {
						auto-layout row; gap 8; align center; width fill
						use Libraries.ui_kit.Icon.kit_Mic as "icon/audio" { width 16; height 16; color #6b3ad3 }
						item rname { title Поддержка; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #0f121a }
						use Libraries.ui_kit.Icon.kit_DotsHorizontal as "icon/more" { width 16; height 16; color #00000099 }
					}
					item people {
						auto-layout row; gap 8; wrap yes; line-gap 8; width fill
						item p1 { auto-layout row; align center; justify center; width 40; height 40; clip yes; color #925cb1; corner-radius 20; item i1 { title AS; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 500; text-color #ffffff } }
						item p2 { auto-layout row; align center; justify center; width 40; height 40; clip yes; color #83af12; corner-radius 20; item i2 { title КМ; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 500; text-color #ffffff } }
					}
					item grow { height fill }
					item footer {
						auto-layout row; gap 6; align center; width fill
						item dot { width 8; height 8; clip yes; color #05a05c; corner-radius 4 }
						item state { title "В эфире 3:05"; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #00000099 }
					}
				}
				item room3 {
					auto-layout column; gap 10; padding 12; width 336; height 512; clip yes; color #ffffff; border-color #00000014; corner-radius 8; pos 840 -24
					item header {
						auto-layout row; gap 8; align center; width fill
						use Libraries.ui_kit.Icon.kit_Camera as "icon/video" { width 16; height 16; color #6b3ad3 }
						item rname { title "Переговорная 2"; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #0f121a }
						use Libraries.ui_kit.Icon.kit_DotsHorizontal as "icon/more" { width 16; height 16; color #00000099 }
					}
					item grow { height fill }
					item footer {
						auto-layout row; gap 6; align center; width fill
						item dot { width 8; height 8; clip yes; color #c4c9d4; corner-radius 4 }
						item state { title Пусто; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #00000099 }
					}
				}
				item room4 {
					auto-layout column; gap 10; padding 12; width 243; height 512; clip yes; color #ffffff; border-color #00000014; corner-radius 8; pos 1200 -24
					item header {
						auto-layout row; gap 8; align center; width fill
						item rname { title "Офис Анны"; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #0f121a }
						use Libraries.ui_kit.Icon.kit_Key as "icon/lock" { width 14; height 14; color #7f7f7f }
					}
					item people {
						auto-layout row; gap 8; wrap yes; line-gap 8; width fill
						item p1 { auto-layout row; align center; justify center; width 40; height 40; clip yes; color #925cb1; corner-radius 20; item i1 { title AS; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 500; text-color #ffffff } }
					}
					item grow { height fill }
					item footer {
						auto-layout row; gap 6; align center; width fill
						item dot { width 8; height 8; clip yes; color #c4c9d4; corner-radius 4 }
						item state { title Закрыта; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #00000099 }
					}
				}
			}
			}
		}
	}
	element "Встреча" {
		use Libraries.workbench.Workbench as "Call screen" {
			pos 2040 0
			replace Top_bar {
				use Libraries.workbench.TopBar as "Top bar" {
					replace tabs.tab.icon_kit_CheckSquare {
						use Libraries.ui_kit.Icon.kit_Building as "icon/kit/Building" { width 12; height 12; color #000000cc }
					}
					at tabs.tab.Tracker { title "Встреча" }
				}
			}
			replace App_rail {
				use Libraries.workbench.AppRail as "App rail" {
					pos 0 -36
					at AppItem_kit_Building { color #e6e6e6; border-color #00000017; line-width 1 }
					at AppItem_kit_Building.icon_kit_Building { color #000000 }
				}
			}
			replace _Navigator {
				use Libraries.workbench.Navigator_tools as Navigator {
					pos 68 -36
					at Chat { title Office }
					slot items {
						use Libraries.workbench.NavCaption as "NavCaption Этажи" {
							pos 16 -56
							at icon_kit_CaretDownFill { hidden no }
							at Channels { title FLOORS }
						}
						use Libraries.workbench.NavItem as "NavItem/Этаж 1" {
							padding 0 8 0 32; pos 13 -88
							replace icon_kit_CheckSquare {
								use Libraries.ui_kit.Icon.kit_Building as "icon/kit/Building" { color #0f121a }
							}
							at Issues { title "Этаж 1" }
						}
						use Libraries.workbench.NavItem as "NavItem/Этаж 2" { padding 0 8 0 32; pos 13 -120; at Issues { title "Этаж 2" } }
						item divider { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -156 }
						use Libraries.workbench.NavCaption as "NavCaption Встречи" {
							pos 16 -182
							at icon_kit_CaretDownFill { hidden no }
							at Channels { title MEETINGS }
						}
						use Libraries.workbench.NavItem as "NavItem/Сегодня" {
							selected true; padding 0 8 0 32; pos 13 -214
							replace icon_kit_CheckSquare {
								use Libraries.ui_kit.Icon.kit_Calendar as "icon/kit/Calendar" { color #0f121a }
							}
							at Issues { title Сегодня }
						}
						use Libraries.workbench.NavItem as "NavItem/Записи" { padding 0 8 0 32; pos 13 -246; at Issues { title Записи } }
						item "footer line" { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -282 }
					}
				}
			}
			slot Main_panel {
				item call_header {
					auto-layout row; gap 10; align center; width 1467; height 48; padding 0 8; pos 24 0
					item call_title { title Планёрка; font-size 20; line-height 24; font-family "IBM Plex Sans"; font-weight 700; layout left; text-color #0f121a }
					item timer { title "12:34"; font-size 13; line-height 16; font-family "IBM Plex Sans"; text-color #00000099; color #1725470d; corner-radius 6; padding 4 8 }
					item spacer { width fill }
					use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/medium" {
						kind ghost; size medium; shape icon
						replace icon_kit_PencilLine {
							use Libraries.ui_kit.Icon.kit_PencilLine as "icon/kit/PencilLine" { color #00000099 }
						}
					}
					use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/medium 2" {
						kind ghost; size medium; shape icon
						replace icon_kit_PencilLine {
							use Libraries.ui_kit.Icon.users as "icon/users" { width 18; height 18; border-color #00000099 }
						}
					}
				}
			item videos {
				auto-layout abs; width 733; height 416; pos 391 -76
				item tile1 { auto-layout abs; width 350; height 200; clip yes; color #232b3d; corner-radius 8; pos 0 -216
					item a1 { auto-layout row; align center; justify center; width 48; height 48; clip yes; color #925cb1; corner-radius 12; pos 151 -124; item i1 { title AS; font-size 20; line-height 24; font-family "IBM Plex Sans"; font-weight 600; text-color #ffffff } }
					item n1 { title "Анна Смит"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #ffffff; pos 12 -12 }
					use Libraries.ui_kit.Icon.kit_Mic as "icon/mic1" { width 16; height 16; color #ffffff; pos 322 -12 }
				}
				item tile2 { auto-layout abs; width 350; height 200; clip yes; color #232b3d; corner-radius 8; pos 366 -216
					item a2 { auto-layout row; align center; justify center; width 48; height 48; clip yes; color #758595; corner-radius 12; pos 151 -124; item i2 { title CM; font-size 20; line-height 24; font-family "IBM Plex Sans"; font-weight 600; text-color #ffffff } }
					item n2 { title "Мария Коул"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #ffffff; pos 12 -12 }
					use Libraries.ui_kit.Icon.kit_Mic as "icon/mic2" { width 16; height 16; color #ffffff66; pos 322 -12 }
				}
				item tile3 { auto-layout abs; width 350; height 200; clip yes; color #232b3d; corner-radius 8; pos 0 0
					item a3 { auto-layout row; align center; justify center; width 48; height 48; clip yes; color #dc85f5; corner-radius 12; pos 151 -124; item i3 { title PI; font-size 20; line-height 24; font-family "IBM Plex Sans"; font-weight 600; text-color #ffffff } }
					item n3 { title "Иван Петров"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #ffffff; pos 12 -12 }
					use Libraries.ui_kit.Icon.kit_Mic as "icon/mic3" { width 16; height 16; color #ffffff; pos 322 -12 }
				}
				item tile4 { auto-layout abs; width 350; height 200; clip yes; color #232b3d; corner-radius 8; pos 366 0
					item a4 { auto-layout row; align center; justify center; width 48; height 48; clip yes; color #4d7fd1; corner-radius 12; pos 151 -124; item i4 { title AJ; font-size 20; line-height 24; font-family "IBM Plex Sans"; font-weight 600; text-color #ffffff } }
					item n4 { title "Алекс Джонсон"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #ffffff; pos 12 -12 }
					use Libraries.ui_kit.Icon.kit_Mic as "icon/mic4" { width 16; height 16; color #ffffff; pos 322 -12 }
				}
			}
			item control_bar {
				auto-layout row; gap 8; align center; width 800; height 64; pos 357 -968
				item btn_mic {
					auto-layout row; align center; justify center; width 40; height 40; clip yes; color #1725470d; corner-radius 20
					use Libraries.ui_kit.Icon.kit_Mic as "icon/mic" { width 18; height 18; color #0f121a }
				}
				item btn_cam {
					auto-layout row; align center; justify center; width 40; height 40; clip yes; color #1725470d; corner-radius 20
					use Libraries.ui_kit.Icon.kit_Camera as "icon/cam" { width 18; height 18; color #0f121a }
				}
				item btn_share {
					auto-layout row; align center; justify center; width 40; height 40; clip yes; color #1725470d; corner-radius 20
					use Libraries.ui_kit.Icon.kit_ArrowUpLines as "icon/share" { width 18; height 18; color #0f121a }
				}
				item cb_divider { width 1; height 24; clip yes; color #0000001a }
				item btn_rec {
					auto-layout row; align center; justify center; width 40; height 40; clip yes; color #1725470d; corner-radius 20
					use Libraries.ui_kit.Icon.recorder_Rec as "icon/rec" { width 18; height 18; color ${ctx.inkHint} }
				}
				item cb_spacer { width 210 }
				item btn_people {
					auto-layout row; gap 6; align center; height 40; padding 0 12; clip yes; color #1725470d; corner-radius 20
					use Libraries.ui_kit.Icon.users as "icon/users 2" { width 18; height 18; border-color #0f121a }
					item pc { title 4; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; text-color #0f121a }
				}
				item btn_chat {
					auto-layout row; align center; justify center; width 40; height 40; clip yes; color #1725470d; corner-radius 20
					use Libraries.ui_kit.Icon.kit_Bubble as "icon/chat" { width 18; height 18; color #0f121a }
				}
				use Libraries.ui_kit.Actions.Button as "Button/leave" {
					label Покинуть; kind negative
				}
			}
			}
		}
	}
}

element "Этаж dark" {
	use Theme as skin {
		theme Dark
		slot content {
			use Libraries.workbench.Workbench as "Floor dark" {
				pos 0 0
				replace Top_bar {
					use Libraries.workbench.TopBar as "Top bar" {
						replace tabs.tab.icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.kit_Building as "icon/kit/Building" { width 12; height 12; color #ffffffcc }
						}
						at tabs.tab.Tracker { title Office }
					}
				}
				replace App_rail {
					use Libraries.workbench.AppRail as "App rail" {
						pos 0 -36
						at AppItem_kit_Building { color #2a3145; border-color #3a4250; line-width 1 }
						at AppItem_kit_Building.icon_kit_Building { color #ffffff }
					}
				}
				replace _Navigator {
					use Libraries.workbench.Navigator_tools as Navigator {
						pos 68 -36
						at Chat { title Office }
						slot items {
							use Libraries.workbench.NavCaption as "NavCaption Этажи" {
								pos 16 -56
								at icon_kit_CaretDownFill { hidden no }
								at Channels { title FLOORS }
							}
							use Libraries.workbench.NavItem as "NavItem/Этаж 1" {
								selected true; padding 0 8 0 32; pos 13 -88
								replace icon_kit_CheckSquare {
									use Libraries.ui_kit.Icon.kit_Building as "icon/kit/Building" { color #ffffff }
								}
								at Issues { title "Этаж 1" }
							}
							use Libraries.workbench.NavItem as "NavItem/Этаж 2" { padding 0 8 0 32; pos 13 -120; at Issues { title "Этаж 2" } }
							item divider { auto-layout abs; width 279; height 1; clip yes; color #2c3442; pos 1 -156 }
							use Libraries.workbench.NavCaption as "NavCaption Встречи" {
								pos 16 -182
								at icon_kit_CaretDownFill { hidden no }
								at Channels { title MEETINGS }
							}
							use Libraries.workbench.NavItem as "NavItem/Сегодня" {
								padding 0 8 0 32; pos 13 -214
								replace icon_kit_CheckSquare {
									use Libraries.ui_kit.Icon.kit_Calendar as "icon/kit/Calendar" { color #ffffff }
								}
								at Issues { title Сегодня }
							}
							use Libraries.workbench.NavItem as "NavItem/Записи" { padding 0 8 0 32; pos 13 -246; at Issues { title Записи } }
							item "footer line" { auto-layout abs; width 279; height 1; clip yes; color #2c3442; pos 1 -282 }
						}
					}
				}
				slot Main_panel {
					item floor_header {
						auto-layout row; gap 12; align center; width 1467; height 48; padding 0 8; pos 24 0
						item floor_title { title "Этаж 1"; width fill; font-size 20; line-height 24; font-family "IBM Plex Sans"; font-weight 700; layout left; text-color #ffffff }
						use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/medium" {
							kind ghost; size medium; shape icon
							replace icon_kit_PencilLine {
								use Libraries.ui_kit.Icon.kit_Gear as "icon/kit/Gear" { color #8e99af }
							}
						}
						use Libraries.ui_kit.Actions.Button as "Button/new-room" {
							label Комната
						}
					}
					item rooms {
						auto-layout abs; width 1467; height 360; pos 24 -68
						use RoomTile as "RoomTile/Планёрка" { a3 true; extra "+2"; pos 0 0 }
						use RoomTile as "RoomTile/Поддержка" { name Поддержка; rtype audio; info "В эфире 3:05"; a2 false; a3 false; more false; pos 256 0 }
						use RoomTile as "RoomTile/Переговорная 2" { name "Переговорная 2"; info Пусто; live false; a1 false; a2 false; more false; pos 512 0 }
						use RoomTile as "RoomTile/Офис Анны" { name "Офис Анны"; info "Закрыта"; locked true; a2 false; a3 false; more false; pos 768 0 }
					}
				}
			}
		}
	}
}