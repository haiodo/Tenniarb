				item d7 { title "Вс 16"; width 174; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f; pos 1092 0 }
			}
			item person1 {
				auto-layout abs; width 1483; height 64; pos 16 -92
				use Libraries.ui_kit.People.Avatar as "Avatar/28" { width 28; height 28; corner-radius 7; color #925cb1; pos 0 -18; at initials { title AS; font-size 12; line-height 14 } }
