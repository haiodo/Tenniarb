element "Мой план dark" {
	use Theme as skin {
		theme Dark
		slot content {
			use Libraries.workbench.Workbench as "Planner dark" {
				pos 0 0
				replace Top_bar {
					use Libraries.workbench.TopBar as "Top bar" {
						replace tabs.tab.icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.kit_Calendar as "icon/kit/Calendar" { width 12; height 12; color #ffffffcc }
