entry "../PlatformDesign.tenn"
context --from-item Light

element "Me" {
	element "Мой план" {
		use Libraries.workbench.Workbench as "Planner screen" {
			pos 0 0
			replace Top_bar {
				use Libraries.workbench.TopBar as "Top bar" {
					replace tabs.tab.icon_kit_CheckSquare {
						use Libraries.ui_kit.Icon.kit_Calendar as "icon/kit/Calendar" { width 12; height 12; color #000000cc }
					}
					at tabs.tab.Tracker { title Planner }
				}
			}
			replace App_rail {
				use Libraries.workbench.AppRail as "App rail" {
					pos 0 -36
					at AppItem_kit_Calendar { color #e6e6e6; border-color #00000017; line-width 1 }
					at AppItem_kit_Calendar.icon_kit_Calendar { color #000000 }
				}
			}
			replace _Navigator {
				use Libraries.workbench.Navigator_tools as Navigator {
					pos 68 -36
					at Chat { title Planner }
					slot items {
						use Libraries.workbench.NavItem as "NavItem/Сегодня" {
							selected true; pos 13 -56
							replace icon_kit_CheckSquare {
								use Libraries.ui_kit.Icon.kit_Calendar as "icon/kit/Calendar" { color #0f121a }
							}
							at Issues { title "Сегодня" }
						}
						use Libraries.workbench.NavItem as "NavItem/Завтра" { pos 13 -88; at Issues { title "Завтра" } }
						use Libraries.workbench.NavItem as "NavItem/Просрочено" { pos 13 -120; at Issues { title "Просрочено" } }
						use Libraries.workbench.NavItem as "NavItem/Без даты" { pos 13 -152; at Issues { title "Без даты" } }
						item divider { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -188 }
						use Libraries.workbench.NavCaption as "NavCaption Проекты" {
							pos 16 -214
							at icon_kit_CaretDownFill { hidden no }
							at Channels { title PROJECTS }
						}
						use Libraries.workbench.NavItem as "NavItem/Мобильное приложение" { padding 0 8 0 32; pos 13 -246; at Issues { title "Мобильное приложение" } }
						use Libraries.workbench.NavItem as "NavItem/Веб-приложение" { padding 0 8 0 32; pos 13 -278; at Issues { title "Веб-приложение" } }
						item "footer line" { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -314 }
					}
				}
			}
		slot Main_panel {
			item "ToDos navigator" {
				auto-layout abs; width 300; height 1044; clip yes; color #fbfbfc; pos 0 0
				item title { title План; font-size 20; line-height 24; font-family "IBM Plex Sans"; font-weight 700; layout left; text-color #0f121a; pos 16 -16 }
				use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/small" {
					kind tertiary; size small; shape icon; pos 260 -12
					replace icon_kit_PencilLine {
						use Libraries.ui_kit.Icon.kit_Plus as "icon/kit/Plus" { color #6b3ad3 }
					}
				}
				item divider { auto-layout abs; width 1; height 1044; clip yes; color #0000000f; pos 299 0 }
			}
			item ToDos {
				auto-layout abs; width 640; height 1044; clip yes; color #ffffff; pos 300 0
				item day_header { title "Сегодня, 10 ноября"; font-size 16; line-height 20; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #0f121a; pos 16 -16 }
				item todo1 {
				auto-layout abs; width 608; height 64; pos 16 -52
				item checkbox { width 18; height 18; clip yes; border-color #6b3ad3; line-width 2; corner-radius 9; pos 0 -23 }
				item text {
					auto-layout column; gap 4; width 400; pos 28 0
					item t1 { title "Подготовить демо планировщика"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #0f121a }
					item meta {
						auto-layout row; gap 6; align center
						item chip { title "Мобильное приложение"; font-size 11; line-height 14; font-family "IBM Plex Sans"; text-color #6b3ad3; color #6b3ad31a; corner-radius 4; padding 2 6 }
						item dur { title 4ч; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #7f7f7f }
					}
				}
				item time1 { title "10:00 - 14:00"; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #7f7f7f; pos 508 -24 }
			}
				item todo2 {
				auto-layout abs; width 608; height 64; pos 16 -116
				item checkbox { width 18; height 18; clip yes; border-color #6b3ad3; line-width 2; corner-radius 9; pos 0 -23 }
				item text {
					auto-layout column; gap 4; width 400; pos 28 0
					item t1 { title "Ответить на review APP-13"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #0f121a }
					item meta {
						auto-layout row; gap 6; align center
						item chip { title APP-13; font-size 11; line-height 14; font-family "IBM Plex Sans"; text-color #6b3ad3; color #6b3ad31a; corner-radius 4; padding 2 6 }
						item dur { title 1ч; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #7f7f7f }
					}
				}
				item time1 { title "14:30 - 15:30"; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #7f7f7f; pos 508 -24 }
			}
				item todo3 {
					auto-layout abs; width 608; height 64; pos 16 -180
					item checkbox {
						width 18; height 18; clip yes; color #6b3ad3; corner-radius 9; pos 0 -23
						use Libraries.ui_kit.Icon.tick as tick { width 12; height 12; border-color #ffffff; line-width 0.98; pos 3 -3 }
					}
					item text {
						auto-layout column; gap 4; width 400; pos 28 0
						item t1 { title "Сверить токены с кодом"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
						item meta {
							auto-layout row; gap 6; align center
							item chip { title "Веб-приложение"; font-size 11; line-height 14; font-family "IBM Plex Sans"; text-color #6b3ad3; color #6b3ad31a; corner-radius 4; padding 2 6 }
							item dur { title 30м; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #7f7f7f }
						}
					}
				}
				item tomorrow_header { title "Завтра, 11 ноября"; font-size 16; line-height 20; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #0f121a; pos 16 -268 }
				item todo4 {
					auto-layout abs; width 608; height 64; pos 16 -304
					item checkbox { width 18; height 18; clip yes; border-color #6b3ad3; line-width 2; corner-radius 9; pos 0 -23 }
					item text {
						auto-layout column; gap 4; width 400; pos 28 0
						item t1 { title "Прогон sanity-тестов планировщика"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #0f121a }
						item meta {
							auto-layout row; gap 6; align center
							item chip { title "Мобильное приложение"; font-size 11; line-height 14; font-family "IBM Plex Sans"; text-color #6b3ad3; color #6b3ad31a; corner-radius 4; padding 2 6 }
							item dur { title 2ч; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #7f7f7f }
						}
					}
				item time1 { title "09:00 - 11:00"; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #7f7f7f; pos 508 -24 }
			}
				item divider { auto-layout abs; width 1; height 1044; clip yes; color #0000000f; pos 639 0 }
			}
			item "Planning calendar" {
				auto-layout abs; width 575; height 1044; clip yes; color #ffffff; pos 940 0
				item cal_header {
					auto-layout row; gap 8; align center; width 543; height 36; padding 0 16; pos 16 -8
				use Libraries.ui_kit.Icon.kit_ChevronLeftLarge as "icon/kit/ChevronLeftLarge" { width 16; height 16; color #00000099 }
				item cal_title { title "10 ноября 2026"; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #0f121a }
				use Libraries.ui_kit.Icon.kit_ChevronRightLarge as "icon/kit/ChevronRightLarge" { width 16; height 16; color #00000099 }
				use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/small" {
					kind ghost; size small; shape icon
					replace icon_kit_PencilLine {
						use Libraries.ui_kit.Icon.kit_Plus as "icon/kit/Plus" { color #00000099 }
					}
				}
			}
			item hours {
				auto-layout abs; width 575; height 832; clip yes; pos 0 -52
				item h8 {
					auto-layout row; gap 8; align center; width 575; height 64; pos 0 0
					item lbl { title "8:00"; width 44; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f; pos 8 0 }
					item line { auto-layout abs; width 507; height 1; clip yes; color #0000000f; pos 60 0 }
				}
				item h9 {
					auto-layout row; gap 8; align center; width 575; height 64; pos 0 -64
					item lbl { title "9:00"; width 44; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f; pos 8 0 }
					item line { auto-layout abs; width 507; height 1; clip yes; color #0000000f; pos 60 0 }
				}
				item h10 {
					auto-layout row; gap 8; align center; width 575; height 64; pos 0 -128
					item lbl { title "10:00"; width 44; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f; pos 8 0 }
					item line { auto-layout abs; width 507; height 1; clip yes; color #0000000f; pos 60 0 }
				}
				item h11 {
					auto-layout row; gap 8; align center; width 575; height 64; pos 0 -192
					item lbl { title "11:00"; width 44; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f; pos 8 0 }
					item line { auto-layout abs; width 507; height 1; clip yes; color #0000000f; pos 60 0 }
				}
				item h12 {
					auto-layout row; gap 8; align center; width 575; height 64; pos 0 -256
					item lbl { title "12:00"; width 44; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f; pos 8 0 }
					item line { auto-layout abs; width 507; height 1; clip yes; color #0000000f; pos 60 0 }
				}
				item h13 {
					auto-layout row; gap 8; align center; width 575; height 64; pos 0 -320
					item lbl { title "13:00"; width 44; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f; pos 8 0 }
					item line { auto-layout abs; width 507; height 1; clip yes; color #0000000f; pos 60 0 }
				}
				item h14 {
					auto-layout row; gap 8; align center; width 575; height 64; pos 0 -384
					item lbl { title "14:00"; width 44; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f; pos 8 0 }
					item line { auto-layout abs; width 507; height 1; clip yes; color #0000000f; pos 60 0 }
				}
				item h15 {
					auto-layout row; gap 8; align center; width 575; height 64; pos 0 -448
					item lbl { title "15:00"; width 44; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f; pos 8 0 }
					item line { auto-layout abs; width 507; height 1; clip yes; color #0000000f; pos 60 0 }
				}
				item event1 {
					auto-layout column; gap 2; width 499; height 256; padding 8; clip yes; color #6b3ad31a; corner-radius 6; border-color #6b3ad3; line-width 1; pos 60 -128
					item et1 { title "Подготовить демо планировщика"; width fill; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #6b3ad3 }
					item et2 { title "10:00 - 14:00"; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #6b3ad3 }
				}
				item event2 {
					auto-layout column; gap 2; width 499; height 56; padding 8; clip yes; color #6b3ad31a; corner-radius 6; border-color #6b3ad3; line-width 1; pos 60 -416
					item et1 { title "Ответить на review APP-13"; width fill; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #6b3ad3 }
					item et2 { title "14:30 - 15:30"; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #6b3ad3 }
				}
			}
			}
		}
	}
}
}

element "Team" {
	element "Team Planner" {
		use Libraries.workbench.Workbench as "Team screen" {
			pos 2040 0
			replace Top_bar {
				use Libraries.workbench.TopBar as "Top bar" {
					replace tabs.tab.icon_kit_CheckSquare {
						use Libraries.ui_kit.Icon.kit_Calendar as "icon/kit/Calendar" { width 12; height 12; color #000000cc }
					}
					at tabs.tab.Tracker { title "Team Planner" }
				}
			}
			replace App_rail {
				use Libraries.workbench.AppRail as "App rail" {
					pos 0 -36
					at AppItem_kit_Calendar { color #e6e6e6; border-color #00000017; line-width 1 }
					at AppItem_kit_Calendar.icon_kit_Calendar { color #000000 }
				}
			}
			replace _Navigator {
				use Libraries.workbench.Navigator_tools as Navigator {
					pos 68 -36
					at Chat { title "Team Planner" }
					slot items {
						use Libraries.workbench.NavItem as "NavItem/Команда" {
							selected true; pos 13 -56
							replace icon_kit_CheckSquare {
								use Libraries.ui_kit.Icon.kit_People as "icon/kit/People" { color #0f121a }
							}
							at Issues { title Команда }
						}
						use Libraries.workbench.NavItem as "NavItem/Календарь" {
							pos 13 -88
							replace icon_kit_CheckSquare {
								use Libraries.ui_kit.Icon.kit_Calendar as "icon/kit/Calendar" { color #0f121a }
							}
							at Issues { title Календарь }
						}
						item divider { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -124 }
						use Libraries.workbench.NavCaption as "NavCaption Команда" {
							pos 16 -150
							at icon_kit_CaretDownFill { hidden no }
							at Channels { title TEAM }
						}
						use Libraries.workbench.NavItem as "NavItem/Все участники" { padding 0 8 0 32; pos 13 -182; at Issues { title "Все участники" } }
						item "footer line" { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -218 }
					}
				}
			}
		slot Main_panel {
			item tp_header {
				auto-layout row; gap 12; align center; width 1483; height 48; padding 0 16; pos 16 0
				item tp_title { title "Команда · неделя 10-16 ноября"; width fill; font-size 16; line-height 20; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #0f121a }
				item filter1 {
				auto-layout row; gap 6; align center; height 32; padding 0 10; clip yes; border-color #00000017; corner-radius 6
				item f1 { title "Все проекты"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #0f121a }
				use Libraries.ui_kit.Icon.kit_ChevronDown as "icon/kit/ChevronDown" { width 14; height 14; color #00000099 }
				}
				item filter2 {
				auto-layout row; gap 6; align center; height 32; padding 0 10; clip yes; border-color #00000017; corner-radius 6
				item f2 { title "Все участники"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #0f121a }
				use Libraries.ui_kit.Icon.kit_ChevronDown as "icon/kit/ChevronDown 2" { width 14; height 14; color #00000099 }
				}
				use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/medium" {
					kind ghost; size medium; shape icon
					replace icon_kit_PencilLine {
						use Libraries.ui_kit.Icon.kit_Search as "icon/kit/Search" { color #00000099 }
					}
				}
			}
			item days {
				auto-layout abs; width 1310; height 20; pos 188 -60
				item d1 { title "Пн 10"; width 174; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f; pos 0 0 }
				item d2 { title "Вт 11"; width 174; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f; pos 182 0 }
				item d3 { title "Ср 12"; width 174; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f; pos 364 0 }
				item d4 { title "Чт 13"; width 174; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f; pos 546 0 }
