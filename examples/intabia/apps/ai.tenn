entry "../PlatformDesign.tenn"
context --from-item Light

element "Assistant" {
	element "Диалог" {
		use Libraries.workbench.Workbench as "AI screen" {
			pos 0 0
			replace Top_bar {
				use Libraries.workbench.TopBar as "Top bar" {
					replace tabs.tab.icon_kit_CheckSquare {
						use Libraries.ui_kit.Icon.kit_Sparkle as "icon/kit/Sparkle" { width 12; height 12; color #000000cc }
					}
					at tabs.tab.Tracker { title AI }
				}
			}
			replace App_rail {
				use Libraries.workbench.AppRail as "App rail" {
					pos 0 -36
					at AppItem_kit_Lightning { color #e6e6e6; border-color #00000017; line-width 1 }
					at AppItem_kit_Lightning.icon_kit_Lightning { color #000000 }
				}
			}
			replace _Navigator {
				use Libraries.workbench.Navigator_tools as Navigator {
					pos 68 -36
					at Chat { title Chat }
					slot items {
						use Libraries.workbench.NavCaption as "NavCaption Channels" {
							pos 16 -56
							at icon_kit_CaretDownFill { hidden no }
							at Channels { title CHANNELS }
						}
						use Libraries.workbench.NavItem as "NavItem/general" {
							pos 13 -88
							replace icon_kit_CheckSquare {
								use Libraries.ui_kit.Icon.kit_Hash as "icon/kit/Hash" { color #0f121a }
							}
							at Issues { title general }
						}
						item divider { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -124 }
						use Libraries.workbench.NavCaption as "NavCaption Direct" {
							pos 16 -150
							at icon_kit_CaretDownFill { hidden no }
							at Channels { title "DIRECT MESSAGES" }
						}
						use Libraries.workbench."NavItem/object" as "NavItem/Юля AI" {
							selected true; label "Юля AI"; pos 13 -182
							replace tile.icon_kit_Hash {
								use Libraries.ui_kit.Icon.kit_Sparkle as "icon/kit/Sparkle" { color #6b3ad3 }
							}
						}
						item "footer line" { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -218 }
					}
				}
			}
		slot Main_panel {
			use Libraries.workbench.PanelHeader_divided as "Panel header" {
				width 1515
				at Panel_header { width 1515 }
				replace Panel_header.Breadcrumb.avatar.icon_kit_People {
					use Libraries.ui_kit.Icon.kit_Sparkle as "icon/kit/Sparkle" { color #6b3ad3 }
				}
				at Panel_header.Breadcrumb.Members { title "Юля AI" }
				at divider { width 1515 }
				slot actions {
					use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/medium" {
					kind ghost; size medium; shape icon
					replace icon_kit_PencilLine {
						use Libraries.ui_kit.Icon.kit_DotsHorizontal as "icon/kit/DotsHorizontal" { color #00000099 }
					}
				}
				}
			}
			item Messages {
				auto-layout column; width 1513; height 500; clip yes; pos 1 -60
				use Libraries.chat_kit.DateSeparator as "Date Today" {
				at date_row.date.Tuesday_March_29 { title Today }
			}
				use Libraries.chat_kit.Message as "Message Anna Johnson" {
				replace avatar.Avatar_40 {
					use Libraries.ui_kit.People.Avatar as "Avatar/40" {
						width 40; height 40; color #925cb1; corner-radius 8
						at initials { title AJ; font-size 17; line-height 21 }
					}
				}
				at body.header.Anna_Smith { title "Anna Johnson" }
				at body.header._10_12_AM { title "10:02 AM" }
				at body.The_new_column_is_in__please_check_the_o { title "Собери план релиза 0.8.60 по открытым задачам трекера" }
			}
			item "AI answer" {
				auto-layout row; gap 12; align start; width 1467; padding 0 16
				item ai_avatar {
					auto-layout row; align center; justify center; width 40; height 40; clip yes; color #6b3ad3; corner-radius 8
					use Libraries.ui_kit.Icon.kit_Sparkle as "icon/kit/Sparkle" { width 20; height 20; color #ffffff }
				}
				item ai_body {
				auto-layout column; gap 4; width 1100
				item ai_header { auto-layout row; gap 8; align center
					item ai_name { title "Юля AI"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #0f121a }
					item ai_time { title "10:04 AM"; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #7f7f7f }
				}
				item ai_text { title "Подготовила план. Предлагаю начать с проверки уведомлений:"; width fill; font-size 14; line-height 20; font-family "IBM Plex Sans"; layout left; text-color #000000cc }
				item "Task proposal" {
				auto-layout column; gap 10; width 620; padding 14; clip yes; color #ffffff; corner-radius 10; border-color #0000001a; line-width 1; shadow 0 -4 16
				item tp_header { auto-layout row; gap 8; align center; width 592
					use Libraries.ui_kit.Icon.kit_Sparkle as "icon/kit/Sparkle" { width 16; height 16; color #6b3ad3 }
					item tp_title { title "Новая задача"; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #0f121a }
					use Libraries.ui_kit.Icon.kit_Cross as "icon/kit/Cross" { width 14; height 14; color #7f7f7f }
				}
				item tp_l1 { title Название; font-size 12; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f }
				item tp_v1 { title "Проверить бейджи уведомлений в каналах"; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #0f121a }
				item tp_l2 { title Подзадачи; font-size 12; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #7f7f7f }
				item sub1 { auto-layout row; gap 8; align center; width 592
					item cbx { width 16; height 16; clip yes; border-color #6b3ad3; line-width 1.5; corner-radius 4 }
					item st { title "Проверить счётчики непрочитанного"; width fill; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #000000cc }
				}
				item sub2 { auto-layout row; gap 8; align center; width 592
					item cbx { width 16; height 16; clip yes; border-color #6b3ad3; line-width 1.5; corner-radius 4 }
					item st { title "Сверить цвет бейджа с токенами"; width fill; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #000000cc }
				}
				item sub3 { auto-layout row; gap 8; align center; width 592
					item cbx { width 16; height 16; clip yes; border-color #6b3ad3; line-width 1.5; corner-radius 4 }
					item st { title "Обновить скриншоты в документации"; width fill; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #000000cc }
				}
				item tp_actions { auto-layout row; gap 8; align center; width 592; justify end
					use Libraries.ui_kit.Actions.Button as "Button/create" {
						label "Создать задачу"
					}
					use Libraries.ui_kit.Actions.Button as "Button/decline" {
						label Отклонить; kind secondary
					}
				}
				}
			}
			}
		}
			use Libraries.chat_kit.MessageInput as "Message input" { pos 17 -933 }
		}
		}
	}
}

element "Диалог dark" {
	use Theme as skin {
		theme Dark
		slot content {
			use Libraries.workbench.Workbench as "AI dark" {
				pos 0 0
				replace Top_bar {
					use Libraries.workbench.TopBar as "Top bar" {
						replace tabs.tab.icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.kit_Sparkle as "icon/kit/Sparkle" { width 12; height 12; color #ffffffcc }
						}
						at tabs.tab.Tracker { title AI }
					}
				}
				replace App_rail {
					use Libraries.workbench.AppRail as "App rail" {
						pos 0 -36
						at AppItem_kit_Lightning { color #2a3145; border-color #3a4250; line-width 1 }
						at AppItem_kit_Lightning.icon_kit_Lightning { color #ffffff }
					}
				}
				replace _Navigator {
					use Libraries.workbench.Navigator_tools as Navigator {
						pos 68 -36
						at Chat { title Chat }
						slot items {
							use Libraries.workbench.NavCaption as "NavCaption Channels" {
								pos 16 -56
								at icon_kit_CaretDownFill { hidden no }
								at Channels { title CHANNELS }
							}
							use Libraries.workbench.NavItem as "NavItem/general" {
								pos 13 -88
								replace icon_kit_CheckSquare {
									use Libraries.ui_kit.Icon.kit_Hash as "icon/kit/Hash" { color #ffffff }
								}
								at Issues { title general }
							}
							item divider { auto-layout abs; width 279; height 1; clip yes; color #2c3442; pos 1 -124 }
							use Libraries.workbench.NavCaption as "NavCaption Direct" {
								pos 16 -150
								at icon_kit_CaretDownFill { hidden no }
								at Channels { title "DIRECT MESSAGES" }
							}
							use Libraries.workbench."NavItem/object" as "NavItem/Юля AI" {
								selected true; label "Юля AI"; pos 13 -182
								replace tile.icon_kit_Hash {
									use Libraries.ui_kit.Icon.kit_Sparkle as "icon/kit/Sparkle" { color #a5bdff }
								}
							}
							item "footer line" { auto-layout abs; width 279; height 1; clip yes; color #2c3442; pos 1 -218 }
						}
					}
				}
				slot Main_panel {
					use Libraries.workbench.PanelHeader_divided as "Panel header" {
						width 1515
						at Panel_header { width 1515 }
						replace Panel_header.Breadcrumb.avatar.icon_kit_People {
							use Libraries.ui_kit.Icon.kit_Sparkle as "icon/kit/Sparkle" { color #a5bdff }
						}
						at Panel_header.Breadcrumb.Members { title "Юля AI" }
						at divider { width 1515 }
						slot actions {
							use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/medium" {
							kind ghost; size medium; shape icon
							replace icon_kit_PencilLine {
								use Libraries.ui_kit.Icon.kit_DotsHorizontal as "icon/kit/DotsHorizontal" { color #8e99af }
							}
						}
					}
				}
				item Messages {
					auto-layout column; width 1513; height 500; clip yes; pos 1 -60
					use Libraries.chat_kit.DateSeparator as "Date Today" {
						at date_row.date.Tuesday_March_29 { title Today }
					}
					use Libraries.chat_kit.Message as "Message Anna Johnson" {
						replace avatar.Avatar_40 {
							use Libraries.ui_kit.People.Avatar as "Avatar/40" { width 40; height 40; color #925cb1; corner-radius 8; at initials { title AJ; font-size 17; line-height 21 } }
						}
						at body.header.Anna_Smith { title "Anna Johnson" }
						at body.header._10_12_AM { title "10:02 AM" }
						at body.The_new_column_is_in__please_check_the_o { title "Собери план релиза 0.8.60 по открытым задачам трекера" }
					}
					item "AI answer" {
						auto-layout row; gap 12; align start; width 1467; padding 0 16
						item ai_avatar {
							auto-layout row; align center; justify center; width 40; height 40; clip yes; color #6b3ad3; corner-radius 8
							use Libraries.ui_kit.Icon.kit_Sparkle as "icon/kit/Sparkle" { width 20; height 20; color #ffffff }
						}
						item ai_body {
							auto-layout column; gap 4; width 1100
							item ai_header {
								auto-layout row; gap 8; align center
								item ai_name { title "Юля AI"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #ffffff }
								item ai_time { title "10:04 AM"; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #8e99af }
							}
							item ai_text { title "Подготовила план. Предлагаю начать с проверки уведомлений:"; width fill; font-size 14; line-height 20; font-family "IBM Plex Sans"; layout left; text-color #c1c9d6 }
							item "Task proposal" {
								auto-layout column; gap 10; width 620; padding 14; clip yes; color #262f40; corner-radius 10; border-color #3a4250; line-width 1; shadow 0 -4 16
								item tp_header {
									auto-layout row; gap 8; align center; width 592
									use Libraries.ui_kit.Icon.kit_Sparkle as "icon/kit/Sparkle" { width 16; height 16; color #a5bdff }
									item tp_title { title "Новая задача"; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #ffffff }
									use Libraries.ui_kit.Icon.kit_Cross as "icon/kit/Cross" { width 14; height 14; color #8e99af }
								}
								item tp_l1 { title Название; font-size 12; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #8e99af }
								item tp_v1 { title "Проверить бейджи уведомлений в каналах"; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #ffffff }
								item tp_l2 { title Подзадачи; font-size 12; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #8e99af }
								item sub1 {
									auto-layout row; gap 8; align center; width 592
									item cbx { width 16; height 16; clip yes; border-color #6b3ad3; line-width 1.5; corner-radius 4 }
									item st { title "Проверить счётчики непрочитанного"; width fill; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #c1c9d6 }
								}
								item sub2 {
									auto-layout row; gap 8; align center; width 592
									item cbx { width 16; height 16; clip yes; border-color #6b3ad3; line-width 1.5; corner-radius 4 }
									item st { title "Сверить цвет бейджа с токенами"; width fill; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #c1c9d6 }
								}
								item tp_actions {
									auto-layout row; gap 8; align center; width 592; justify end
									use Libraries.ui_kit.Actions.Button as "Button/create" {
										label "Создать задачу"
									}
									use Libraries.ui_kit.Actions.Button as "Button/decline" {
										label Отклонить; kind secondary
									}
								}
							}
						}
					}
				}
				use Libraries.chat_kit.MessageInput as "Message input dark" { pos 17 -933 }
				}
			}
		}
	}
}