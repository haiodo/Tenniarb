entry "../PlatformDesign.tenn"
context --from-item Light

element "Inbox" {
	use Libraries.workbench.Workbench as "Inbox screen" {
		pos 0 0
		replace Top_bar {
			use Libraries.workbench.TopBar as "Top bar" {
				replace tabs.tab.icon_kit_CheckSquare {
					use Libraries.ui_kit.Icon.kit_Bell as "icon/kit/Bell" { width 12; height 12; color #000000cc }
				}
				at tabs.tab.Tracker { title Inbox }
			}
		}
		replace App_rail {
			use Libraries.workbench.AppRail as "App rail" {
				pos 0 -36
				at AppItem_kit_Bell { color #e6e6e6; border-color #00000017; line-width 1 }
				at AppItem_kit_Bell.icon_kit_Bell { color #000000 }
			}
		}
		replace _Navigator {
			use Libraries.workbench.Navigator_tools as Navigator {
				pos 68 -36
				at Chat { title Inbox }
				slot items {
					use Libraries.ui_kit.Actions.Tabs as Tabs {
						pos 13 -52; size small; first All; second Threads; third Tasks; selected All
					}
					item filter_row {
						auto-layout row; gap 4; align center; width 254; height 32; padding 0 12; pos 13 -88
						item All_filter { title All; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 500; text-color #6b3ad3 }
						item sep { title "|"; font-size 13; text-color #7f7f7f }
						item Unread_filter { title Unread; font-size 13; line-height 16; font-family "IBM Plex Sans"; text-color #00000099 }
						item spacer { width fill }
						use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/small" {
							kind ghost; size small; shape icon
							replace icon_kit_PencilLine {
								use Libraries.ui_kit.Icon.kit_DotsHorizontal as "icon/kit/DotsHorizontal" { color #00000099 }
							}
						}
						use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/small 2" {
							kind ghost; size small; shape icon
							replace icon_kit_PencilLine {
								use Libraries.ui_kit.Icon.kit_Gear as "icon/kit/Gear" { color #00000099 }
							}
						}
					}
					item "Card/general" {
						auto-layout abs; width 280; height 82; clip yes; pos 0 -124
						item header {
							auto-layout row; gap 8; align center; width 280; height 32; padding 0 12; pos 0 0
							use Libraries.ui_kit.Icon.kit_Hash as "icon/kit/Hash" { width 14; height 14; color #0f121a }
							item title { title general; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #0f121a }
							item time { title "10:12"; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #7f7f7f }
							use Libraries.ui_kit.Icon.kit_Cross as "icon/kit/Cross" { width 14; height 14; color #7f7f7f }
						}
						item rows {
							auto-layout column; gap 4; width 256; pos 12 -38
							item row {
								auto-layout row; gap 8; align center; width 256
								use Libraries.ui_kit.People.Avatar as "Avatar/20" { width 20; height 20; corner-radius 5; color #925cb1; at initials { title SA; font-size 10; line-height 12 } }
								item text { title "Anna Smith: Please review the new column"; width fill; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #000000cc }
							}
						}
						item divider { auto-layout abs; width 280; height 1; clip yes; color #0000000f; pos 0 -81 }
					}
					item "Card/design" {
						auto-layout abs; width 280; height 108; clip yes; pos 0 -206
						item header {
							auto-layout row; gap 8; align center; width 280; height 32; padding 0 12; pos 0 0
							use Libraries.ui_kit.Icon.kit_Hash as "icon/kit/Hash" { width 14; height 14; color #0f121a }
							item title { title design; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #0f121a }
							item time { title "09:47"; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #7f7f7f }
							use Libraries.ui_kit.Icon.kit_Cross as "icon/kit/Cross" { width 14; height 14; color #7f7f7f }
						}
						item rows {
							auto-layout column; gap 4; width 256; pos 12 -38
							item row {
								auto-layout row; gap 8; align center; width 256
								use Libraries.ui_kit.People.Avatar as "Avatar/20" { width 20; height 20; corner-radius 5; color #758595; at initials { title CM; font-size 10; line-height 12 } }
								item text { title "Maria Cole: Set the In Progress limit to 8?"; width fill; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #000000cc }
							}
							item row2 {
								auto-layout row; gap 8; align center; width 256
								use Libraries.ui_kit.Icon.kit_Smiley as "icon/kit/Smiley" { width 16; height 16; color #6b3ad3 }
								item text { title "Maria Cole reacted to your message"; width fill; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
							}
						}
						item divider { auto-layout abs; width 280; height 1; clip yes; color #0000000f; pos 0 -107 }
					}
					item "Card/APP-13" {
						auto-layout abs; width 280; height 82; clip yes; pos 0 -314
						item header {
							auto-layout row; gap 8; align center; width 280; height 32; padding 0 12; pos 0 0
							use Libraries.ui_kit.Icon.kit_Tag as "icon/kit/Tag" { width 14; height 14; color #0f121a }
							item title { title APP-13; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #0f121a }
							item time { title Yesterday; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #7f7f7f }
							use Libraries.ui_kit.Icon.kit_Cross as "icon/kit/Cross" { width 14; height 14; color #7f7f7f }
						}
						item rows {
							auto-layout column; gap 4; width 256; pos 12 -38
							item row {
								auto-layout row; gap 8; align center; width 256
								use Libraries.ui_kit.People.Avatar as "Avatar/20" { width 20; height 20; corner-radius 5; color #dc85f5; at initials { title PI; font-size 10; line-height 12 } }
								item text { title "Ivan Peterson mentioned you: check the tokens"; width fill; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #000000cc }
							}
						}
						item divider { auto-layout abs; width 280; height 1; clip yes; color #0000000f; pos 0 -81 }
					}
					item "footer line" { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -396 }
				}
			}
		}
		slot Main_panel {
			use Libraries.workbench.PanelHeader_divided as "Panel header" {
				width 1515
				at Panel_header { width 1515 }
				replace Panel_header.Breadcrumb.avatar.icon_kit_People {
					use Libraries.ui_kit.Icon.kit_Hash as "icon/kit/Hash" { color #5a667e }
				}
				at Panel_header.Breadcrumb.Members { title general }
				at divider { width 1515 }
				slot actions {
					use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/medium" {
						kind ghost; size medium; shape icon
						replace icon_kit_PencilLine {
							use Libraries.ui_kit.Icon.kit_Search as "icon/kit/Search" { color #00000099 }
						}
					}
					use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/medium 2" {
						kind ghost; size medium; shape icon
						replace icon_kit_PencilLine {
							use Libraries.ui_kit.Icon.kit_ArrowInSquare as "icon/kit/ArrowInSquare" { color #00000099 }
						}
					}
				}
			}
			item Messages {
				auto-layout column; width 1513; height 268; clip yes; justify end; pos 1 -649
				use Libraries.chat_kit.DateSeparator as "Date Today" {
					at date_row.date.Tuesday_March_29 { title Today }
				}
				use Libraries.chat_kit.Message as "Message Anna Smith" {
					replace avatar.Avatar_40 {
						use Libraries.ui_kit.People.Avatar as "Avatar/40" {
							width 40; height 40; color #925cb1; corner-radius 8
							at initials { title SA; font-size 17; line-height 21 }
						}
					}
				}
				use Libraries.chat_kit.Message as "Message Maria Cole" {
					replace avatar.Avatar_40 {
						use Libraries.ui_kit.People.Avatar as "Avatar/40" {
							width 40; height 40; color #758595; corner-radius 8
							at initials { title CM; font-size 17; line-height 21 }
						}
					}
					at body.header.Anna_Smith { title "Maria Cole" }
					at body.header._10_12_AM { title "10:15 AM" }
					at body.The_new_column_is_in__please_check_the_o { title "The order is right. Set the In Progress limit to 8?" }
				}
			}
			use Libraries.chat_kit.MessageInput as "Message input" { pos 17 -933 }
		}
	}
}

element "Inbox dark" {
	use Theme as skin {
		theme Dark
		slot content {
			use Libraries.workbench.Workbench as "Inbox dark screen" {
				pos 0 0
				replace Top_bar {
					use Libraries.workbench.TopBar as "Top bar" {
						replace tabs.tab.icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.kit_Bell as "icon/kit/Bell" { width 12; height 12; color #ffffffcc }
						}
						at tabs.tab.Tracker { title Inbox }
					}
				}
				replace App_rail {
					use Libraries.workbench.AppRail as "App rail" {
						pos 0 -36
						at AppItem_kit_Bell { color #2a3145; border-color #3a4250; line-width 1 }
						at AppItem_kit_Bell.icon_kit_Bell { color #ffffff }
					}
				}
				replace _Navigator {
					use Libraries.workbench.Navigator_tools as Navigator {
						pos 68 -36
						at Chat { title Inbox }
						slot items {
							use Libraries.ui_kit.Actions.Tabs as Tabs {
								pos 13 -52; size small; first All; second Threads; third Tasks; selected All
							}
							item filter_row {
								auto-layout row; gap 4; align center; width 254; height 32; padding 0 12; pos 13 -88
								item All_filter { title All; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 500; text-color #a5bdff }
								item sep { title "|"; font-size 13; text-color #8e99af }
								item Unread_filter { title Unread; font-size 13; line-height 16; font-family "IBM Plex Sans"; text-color #8e99af }
								item spacer { width fill }
								use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/small" {
									kind ghost; size small; shape icon
									replace icon_kit_PencilLine {
										use Libraries.ui_kit.Icon.kit_DotsHorizontal as "icon/kit/DotsHorizontal" { color #8e99af }
									}
								}
								use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/small 2" {
									kind ghost; size small; shape icon
									replace icon_kit_PencilLine {
										use Libraries.ui_kit.Icon.kit_Gear as "icon/kit/Gear" { color #8e99af }
									}
								}
							}
							item "Card/general" {
								auto-layout abs; width 280; height 82; clip yes; pos 0 -124
								item header {
									auto-layout row; gap 8; align center; width 280; height 32; padding 0 12; pos 0 0
									use Libraries.ui_kit.Icon.kit_Hash as "icon/kit/Hash" { width 14; height 14; color #ffffff }
									item title { title general; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #ffffff }
									item time { title "10:12"; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #8e99af }
									use Libraries.ui_kit.Icon.kit_Cross as "icon/kit/Cross" { width 14; height 14; color #8e99af }
								}
								item rows {
									auto-layout column; gap 4; width 256; pos 12 -38
									item row {
										auto-layout row; gap 8; align center; width 256
										use Libraries.ui_kit.People.Avatar as "Avatar/20" { width 20; height 20; corner-radius 5; color #925cb1; at initials { title SA; font-size 10; line-height 12 } }
										item text { title "Anna Smith: Please review the new column"; width fill; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #c1c9d6 }
									}
								}
								item divider { auto-layout abs; width 280; height 1; clip yes; color #2c3442; pos 0 -81 }
							}
							item "Card/APP-13" {
								auto-layout abs; width 280; height 82; clip yes; pos 0 -206
								item header {
									auto-layout row; gap 8; align center; width 280; height 32; padding 0 12; pos 0 0
									use Libraries.ui_kit.Icon.kit_Tag as "icon/kit/Tag" { width 14; height 14; color #ffffff }
									item title { title APP-13; width fill; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #ffffff }
									item time { title Yesterday; font-size 12; line-height 16; font-family "IBM Plex Sans"; text-color #8e99af }
									use Libraries.ui_kit.Icon.kit_Cross as "icon/kit/Cross" { width 14; height 14; color #8e99af }
								}
								item rows {
									auto-layout column; gap 4; width 256; pos 12 -38
									item row {
										auto-layout row; gap 8; align center; width 256
										use Libraries.ui_kit.People.Avatar as "Avatar/20" { width 20; height 20; corner-radius 5; color #dc85f5; at initials { title PI; font-size 10; line-height 12 } }
										item text { title "Ivan Peterson mentioned you: check the tokens"; width fill; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #c1c9d6 }
									}
								}
								item divider { auto-layout abs; width 280; height 1; clip yes; color #2c3442; pos 0 -81 }
							}
							item "footer line" { auto-layout abs; width 279; height 1; clip yes; color #2c3442; pos 1 -288 }
						}
					}
				}
				slot Main_panel {
					use Libraries.workbench.PanelHeader_divided as "Panel header" {
						width 1515
						at Panel_header { width 1515 }
						replace Panel_header.Breadcrumb.avatar.icon_kit_People {
							use Libraries.ui_kit.Icon.kit_Hash as "icon/kit/Hash" { color #8e99af }
						}
						at Panel_header.Breadcrumb.Members { title general }
						at divider { width 1515 }
						slot actions {
							use Libraries.ui_kit.Actions.ClassicButton as "ClassicButton/icon/medium" {
								kind ghost; size medium; shape icon
								replace icon_kit_PencilLine {
									use Libraries.ui_kit.Icon.kit_Search as "icon/kit/Search" { color #8e99af }
								}
							}
					}
				}
				item Messages {
					auto-layout column; width 1513; height 268; clip yes; justify end; pos 1 -649
					use Libraries.chat_kit.DateSeparator as "Date Today" {
						at date_row.date.Tuesday_March_29 { title Today }
					}
					use Libraries.chat_kit.Message as "Message Anna Smith" {
						replace avatar.Avatar_40 {
							use Libraries.ui_kit.People.Avatar as "Avatar/40" { width 40; height 40; color #925cb1; corner-radius 8; at initials { title SA; font-size 17; line-height 21 } }
						}
					}
					use Libraries.chat_kit.Message as "Message Maria Cole" {
						replace avatar.Avatar_40 {
							use Libraries.ui_kit.People.Avatar as "Avatar/40" { width 40; height 40; color #758595; corner-radius 8; at initials { title CM; font-size 17; line-height 21 } }
						}
						at body.header.Anna_Smith { title "Maria Cole" }
						at body.header._10_12_AM { title "10:15 AM" }
						at body.The_new_column_is_in__please_check_the_o { title "The order is right. Set the In Progress limit to 8?" }
					}
				}
				use Libraries.chat_kit.MessageInput as "Message input dark" { pos 17 -933 }
				}
			}
		}
	}
}
