				use Libraries.ui_kit.Icon.board as "icon/board 4" { border-color #0f121a; line-width 1 }
				item n { title "Мой спринт"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; width fill }
				item hint { title "убрать с панели"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
				item check { width 14; height 14; path "M5 8.2L7.2 10.4L11 6"; view-box 0 0 16 16; border-color #0f121a; line-width 1.5 }
