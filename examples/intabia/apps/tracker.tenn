							item wedge { width 12; height 12; path "M6 6L6 3A3 3 0 0 1 9 6Z"; view-box 0 0 12 12; color #5195d7 }
						}
					}
					at In_Progress { title Integration; font-size 13; line-height 16 }
					at _7 { hidden no; title "1"; font-size 13; line-height 16 }
				}
				use Libraries.ui_kit.Status.StatusChip as "StatusChip/Verification" {
					width 228; height 32; color #ffffff; border-color #00000017; line-width 1
					replace StatusIcon_active {
						item "StatusIcon/active" {
							auto-layout abs; width 12; height 12
							item ring { width 10; height 10; corner-radius 5; border-color #5195d7; line-width 1.5; pos 1 -1 }
							item wedge { width 12; height 12; path "M6 6L6 3A3 3 0 0 1 9 6Z"; view-box 0 0 12 12; color #5195d7 }
						}
					}
					at In_Progress { title Verification; font-size 13; line-height 16 }
					at _7 { hidden no; title "0"; font-size 13; line-height 16 }
				}
				use Libraries.ui_kit.Status.StatusChip as "StatusChip/Approval" {
					width 228; height 32; color #ffffff; border-color #00000017; line-width 1
					replace StatusIcon_active {
						item "StatusIcon/active" {
							auto-layout abs; width 12; height 12
							item ring { width 10; height 10; corner-radius 5; border-color #5195d7; line-width 1.5; pos 1 -1 }
							item wedge { width 12; height 12; path "M6 6L6 3A3 3 0 0 1 9 6Z"; view-box 0 0 12 12; color #5195d7 }
						}
					}
					at In_Progress { title Approval; font-size 13; line-height 16 }
					at _7 { hidden no; title "1"; font-size 13; line-height 16 }
				}
			}
		}
	}
	item "card states" {
		auto-layout abs; width 1920; height 1080; clip yes; pos 0 -4800
		use BoardViewFrame as bg { pos 0 0 }
		item overlay {
			auto-layout abs; width 1920; height 1080; clip yes; pos 0 0
			item hint {
			auto-layout abs; width 280; height 62; clip yes; color #1f2129; corner-radius 6; pos 1119 -745
			item text { title "Фокус клавиатуры на карточке: рамка снаружи, рамка внутри (предложение)."; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; padding 8; width fill; text-color #ffffff }
			}
		}
	}
	item "card states annotations" {
		auto-layout abs; width 1920; height 1080; clip yes; pos 2040 -4800
		use BoardViewFrame as bg { pos 0 0 }
		item notes {
			auto-layout abs; width 760; height 100; clip yes; pos 371 -810
			item column {
			auto-layout column; gap 12; width fill; clip yes
			item t1 { title "Наведение: рамка карточки подсвечивается цветом статуса колонки (Ready for QA - оранжевая, Peer Review - красная)."; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; width fill; text-color #000000cc }
			item t2 { title "Фокус клавиатуры: двойная рамка - снаружи цвет статуса, внутри контрастная (предложение)."; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; width fill; text-color #000000cc }
		}
		}
	}
	item "card states drag" {
		auto-layout abs; width 1920; height 1080; clip yes; pos 0 -6000
		use BoardViewFrame as bg { pos 0 0 }
		item "drag card" {
		auto-layout abs; width 190; height 122; clip yes; color #ffffff; border-color #00000017; corner-radius 8; shadow 0 -16 24 #0e131e33; rotate -3; pos 1010 -720
			item body {
			auto-layout column; gap 4; padding 8; width fill; clip yes
			item id { title MKT-5; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #00000066 }
			item title { title "Email-рассылка по базе подписчиков"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left }
		}
		}
		item "cover origin" { auto-layout abs; width 240; height 148; clip yes; color #f7f7f7; pos 364 -613 }
		item "ghost origin" { auto-layout abs; width 220; height 122; clip yes; color #00000008; border-color #00000017; corner-radius 8; pos 376 -621 }
		item "tip origin" {
		auto-layout abs; width 240; height 78; clip yes; color #1f2129; corner-radius 6; pos 376 -640
		item text { title "Отсюда взяли МКТ-5: место сколлапсировалось, карточки ниже поднялись (как в продукте)"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; padding 8; width fill; text-color #ffffff }
		}
		item "target frame" { auto-layout abs; width 236; height 360; clip yes; border-color #6b3ad3; line-width 2; corner-radius 8; pos 873 -452 }
		item "drop badge" {
		auto-layout abs; width 220; height 24; clip yes; color #6b3ad3; corner-radius 4; pos 881 -784
		item text { title "Статус станет: In Progress"; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 600; layout left; padding 4 8; width fill; text-color #ffffff }
		}
		item "tip done" {
		auto-layout abs; width 240; height 92; clip yes; color #1f2129; corner-radius 6; pos 1560 -800
		item text { title "Done не принимает МКТ-5: workflow не разрешает ни Done, ни Released, ни Canceled. Бросок сюда вернёт карточку на место"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; padding 8; width fill; text-color #ffffff }
		}
	}
	item "card states drag annotations" {
		auto-layout abs; width 1920; height 1080; clip yes; pos 2040 -6000
		use BoardViewFrame as bg { pos 0 0 }
		item notes {
			auto-layout abs; width 760; height 100; clip yes; pos 371 -810
			item column {
			auto-layout column; gap 12; width fill; clip yes
			item t1 { title "Перетаскивание: карточка поворачивается и получает тень, курсор - grab."; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; width fill; text-color #000000cc }
			item t2 { title "Исходная колонка показывает контур места, куда карточка вернется при отмене переноса."; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; width fill; text-color #000000cc }
		}
		}
	}
}
element "Boards in issues" {
	use PBIFrame as "Задачи проекта - 1. сегменты у заголовка" {
		pos 0 0
		slot variant {
			item segments {
				auto-layout abs; width 620; height 36; clip yes; color #ffffff; border-color #6b3ad3; line-width 1.5; corner-radius 8; pos 655 -44
				item row {
				auto-layout row; gap 4; padding 4; align center; width fill; height fill; clip yes
				item "Задачи" { title "Задачи"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; padding 6 12; color #6b3ad31a; corner-radius 6; border-color #6b3ad3; text-color #6b3ad3 }
				item Тестирование { title Тестирование; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; padding 6 12; text-color #00000099 }
				item "Мой спринт" { title "Мой спринт"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; padding 6 12; text-color #00000099 }
				item "Основная доска" { title "Основная доска APP·MKT"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; padding 6 12; text-color #00000099 }
				item "Релиз 1.0" { title "Релиз 1.0"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; padding 6 12; text-color #00000099 }
				item plus { title +; font-size 14; line-height 16; font-family "IBM Plex Sans"; layout left; padding 6 10; text-color #00000099 }
				}
