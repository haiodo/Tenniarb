						}
						at Issues { title Архив }
					}
				}
				slot Settings_subtabs {
					use Libraries.settings_kit.SectionTitle as "Section Workflow" {
						at Title { title Workflow }
						at Hint_of_the_section {
							hidden no; title "Какой workflow управляет переходами статусов для каждого типа задач. Изменения применяются сразу."; width 760
						}
					}
					item "Row Задача" {
						auto-layout row; gap 24; align center; width 640; clip yes
						item Задача { title Задача; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099; width fill }
						use Libraries.ui_kit.Forms.SelectButton as "Select/Без workflow" {
							label "Без workflow"; chevron true; width 200
						}
					}
					item "actions" {
						auto-layout row; gap 8; align center; clip yes
						use Libraries.ui_kit.Actions.Button as "Button/secondary/small" {
							kind secondary; size small
							replace icon_kit_Plus {
								use Libraries.ui_kit.Icon.gear as "icon/gear" { border-color #000000; line-width 1 }
							}
							at Button { title "Настроить workflow" }
						}
					}
				}
			}
		}
	}
}

