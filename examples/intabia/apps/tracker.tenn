					}
					slot cards {
						use Libraries.tracker_kit.Cards.IssueCard as "IssueCard APP-13" {
							width 278
							at top.left.id { title APP-13 }
							replace top.Avatar_20 {
								use Libraries.ui_kit.People.Avatar as "Avatar/20" {
									color #1467b3; corner-radius 10
									at initials { title WO; font-size 8; line-height 10 }
								}
							}
							replace title_row.StatusIcon_active {
								item "StatusIcon/todo" {
