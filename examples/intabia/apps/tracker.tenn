				slot Settings_subtabs {
					use Libraries.settings_kit.SectionTitle as "Section Задачи" {
						at Title { title Задачи }
						at Hint_of_the_section { hidden no; title "Значения для новых задач проекта."; width 720 }
					}
					use Libraries.settings_kit.FormRow as "Row Исполнитель по умолчанию" {
						at label.Label { title "Исполнитель по умолчанию" }
						slot control {
							use Libraries.ui_kit.Forms.Input as Input {
								at field.icon_kit_PersonCircle { hidden no }
								at field.Value { title "Не назначен" }
								at field.grow { hidden no }
								at field.icon_chevronD { hidden no }
							}
						}
					}
					use Libraries.settings_kit.FormRow as "Row Статус по умолчанию" {
						at label.Label { title "Статус по умолчанию" }
						slot control {
							use Libraries.ui_kit.Forms.Input as Input {
								at field.Value { title Todo }
								at field.grow { hidden no }
								at field.icon_chevronD { hidden no }
							}
						}
					}
					use Libraries.settings_kit.FormRow as "Row Шаблоны задач" {
						at label.Label { title "Шаблоны задач" }
						slot control {
							use Libraries.ui_kit.Forms.Input as Input {
								replace field.icon_kit_PersonCircle {
									use Libraries.ui_kit.Icon.kit_Layout as "icon/kit/Layout" { color #00000099 }
								}
								at field.Value { title "Открыть шаблоны (3)" }
							}
						}
					}
				}
			}
		}
