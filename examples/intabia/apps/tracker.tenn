					use Libraries.workbench.NavItem as "NavItem/Milestones" {
						padding 0 8 0 32; pos 13 -397
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.milestone as "icon/milestone" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Milestones }
					}
					use Libraries.workbench.NavItem as "NavItem/Templates" {
						padding 0 8 0 32; pos 13 -429
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.kit_Layout as "icon/kit/Layout" { color #0f121a }
						}
						at Issues { title Templates }
					}
					item "footer line" { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -469 }
					}
				}
		}
		slot Main_panel {
			item groups {
				auto-layout column; gap 8; padding 8 24; width 1479; clip yes
				item "group In Progress" {
					auto-layout column; gap 0; width fill; clip yes; border-color #00000017; corner-radius 4
					item header {
						auto-layout row; padding 0 12; align center; width fill; height 44; clip yes; color #d1dfee; corner-radius 4
						item title { title "In Progress 1"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #2e7cc7 }
						item grow { width fill; height 1 }
						item est { title "16h"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #2e7cc7 }
					}
					use Libraries.tracker_kit.List.IssueRow as "MKT-1" {
						width fill
						at row { width fill; height 44 }
						at border { hidden yes }
						slot row {
							item id { title MKT-1; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
							item title { title "Запуск рекламной кампании в соцсетях"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
							item grow { width fill; height 1 }
							item created { title "2 days ago"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
							item modified { title "Oct 21"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
							use Libraries.ui_kit.People.Avatar as "Avatar/24" {
								width 24; height 24; color #4ca6ee; corner-radius 5
								at initials { title СА; font-size 10; line-height 13 }
							}
						}
					}
				}
				item "group Todo" {
					auto-layout column; gap 0; width fill; clip yes; border-color #00000017; corner-radius 4
					item header {
						auto-layout row; padding 0 12; align center; width fill; height 44; clip yes; color #e2e2e2; corner-radius 4
						item title { title "Todo 2"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099 }
						item grow { width fill; height 1 }
						item est { title "7h"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
					}
					item rows {
						auto-layout column; width fill
						use Libraries.tracker_kit.List.IssueRow as "MKT-2" {
							width fill
							at row { width fill; height 44 }
							at border { hidden yes }
							slot row {
								item id { title MKT-2; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
								item title { title "Подготовить пресс-релиз о запуске приложения"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
								item grow { width fill; height 1 }
								item created { title "2 days ago"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
								item modified { title "Oct 21"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
								use Libraries.ui_kit.People.Avatar as "Avatar/24" {
									width 24; height 24; color #4ca6ee; corner-radius 5
									at initials { title СА; font-size 10; line-height 13 }
								}
							}
						}
						use Libraries.tracker_kit.List.IssueRow as "MKT-5" {
							width fill
							at row { width fill; height 44 }
							at border { hidden yes }
							slot row {
								item id { title MKT-5; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
								item title { title "Email-рассылка по базе подписчиков"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
								item grow { width fill; height 1 }
								item created { title "2 days ago"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
								item modified { title "Oct 21"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
								use Libraries.ui_kit.People.Avatar as "Avatar/24" {
									width 24; height 24; color #83af12; corner-radius 5
									at initials { title КМ; font-size 10; line-height 13 }
								}
							}
						}
					}
				}
				item "group Done" {
					auto-layout column; gap 0; width fill; clip yes; border-color #00000017; corner-radius 4
					item header {
						auto-layout row; padding 0 12; align center; width fill; height 44; clip yes; color #d9ead3; corner-radius 4
						item title { title "Done 1"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #6aa84f }
						item grow { width fill; height 1 }
					}
					item rows {
						auto-layout column; width fill
					}
				}
				item "group Backlog" {
					auto-layout column; gap 0; width fill; clip yes; border-color #00000017; corner-radius 4
					item header {
						auto-layout row; padding 0 12; align center; width fill; height 44; clip yes; color #e2e2e2; corner-radius 4
						item title { title "Backlog 3"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099 }
						item grow { width fill; height 1 }
					}
					item rows {
						auto-layout column; width fill
						use Libraries.tracker_kit.List.IssueRow as "MKT-3" {
							width fill
							at row { width fill; height 44 }
							at border { hidden yes }
							slot row {
								item id { title MKT-3; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
								item title { title "Обновить лендинг на сайте"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
								item grow { width fill; height 1 }
								item created { title "2 days ago"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
								item modified { title "Oct 21"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
								use Libraries.ui_kit.People.Avatar as "Avatar/24" {
