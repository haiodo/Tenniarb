								item мин {
									auto-layout row; gap 6; padding 0 8; align center; width 100; height 28; clip yes; color #1530720d; corner-radius 6
									item мин { title мин; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
									item "—" { title "—"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
								}
								item макс {
									auto-layout row; gap 6; padding 0 8; align center; width 100; height 28; clip yes; color #1530720d; corner-radius 6
									item макс { title макс; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
									item "—" { title "—"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
								}
							}
