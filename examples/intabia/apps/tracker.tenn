					item k { title Workflow; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000099; width fill }
					item v { title "2 из 3 типов задач"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left }
				}
				item r4 { auto-layout row; gap 8; align center; width fill; clip yes
					item k { title Настройки; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000099; width fill }
					item v { title "Участники и роли, Приватность, Исполнитель и статус по умолчанию"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left }
				}
				item r5 { auto-layout row; gap 8; align center; width fill; clip yes
					item k { title "Не копируется"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000099; width fill }
					item v { title "Компоненты, Этапы (milestones)"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left }
				}
				}
				item owners {
				auto-layout column; gap 8; width fill; clip yes
				item label { title "Владельцы (1)"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left }
				item row { auto-layout row; gap 8; align center; width fill; clip yes
					use Libraries.ui_kit.People.Avatar as "Avatar/24" {
					width 24; height 24; color #4ca6ee; corner-radius 5
					at initials { title СА; font-size 10; line-height 13 }
					}
					item "Анна Смирнова" { title "Анна Смирнова"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
				}
				}
				item members {
				auto-layout column; gap 8; width fill; clip yes
				item label { title "Участники (2)"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left }
				item row { auto-layout row; gap 8; align center; width fill; clip yes
					use Libraries.ui_kit.People.Avatar as "Avatar/24" {
					width 24; height 24; color #83af12; corner-radius 5
					at initials { title КМ; font-size 10; line-height 13 }
					}
					item "Мария Козлова" { title "Мария Козлова"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
				}
				item row { auto-layout row; gap 8; align center; width fill; clip yes
					use Libraries.ui_kit.People.Avatar as "Avatar/24" {
					width 24; height 24; color #db877d; corner-radius 5
					at initials { title ПИ; font-size 10; line-height 13 }
					}
					item "Иван Петров" { title "Иван Петров"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
				}
				}
			}
		}
		}
	}
}

item CreateProjectWizard {
	export let step = 1; export let count = 5; export let s2 = "2. Участники и доступ"
	auto-layout column; width 792; height 524; clip yes; color #ffffff; corner-radius 12; shadow 0 -24 24 #0e131e1f
	item header {
		auto-layout row; padding 0 24; align center; justify space-between; width fill; height 56; clip yes
		item Title { title "СОЗДАТЬ ПРОЕКТ"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #556178 }
		item right {
			auto-layout row; gap 8; align center; clip yes
			item Esc { title Esc; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
			use Libraries.ui_kit.Actions.Button as Close {
				kind tertiary; size small; shape icon
				replace icon_gear {
					use Libraries.ui_kit.Icon.x as "icon/x" { border-color #5a667e; line-width 1 }
				}
			}
		}
	}
	item divider { auto-layout abs; width fill; height 1; clip yes; color #0000000f }
	item content {
		auto-layout row; width fill; height fill; clip yes
		item side {
			auto-layout column; gap 4; padding 24 16; width 216; height fill; clip yes; border-color #0000000f
			item step1 { auto-layout row; gap 8; align center; width fill; height 32; clip yes
				item dot { width 16; height 16; corner-radius 8; color ${step > 1 ? "#4caf50" : "#ffffff"}; border-color ${step >= 1 ? "#4caf50" : "#00000033"}; line-width 1.5; title ${step > 1 ? "" : "1"}; font-size 9; line-height 11; font-family "IBM Plex Sans"; text-color ${step >= 1 ? "#ffffff" : "#00000066"} }
				item label { title "1. Основное"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight ${step === 1 ? 600 : 400}; layout left; text-color ${step === 1 ? "#0f121a" : "#00000099"} }
			}
			item step2 { auto-layout row; gap 8; align center; width fill; height 32; clip yes
				item dot { width 16; height 16; corner-radius 8; color ${step > 2 ? "#4caf50" : "#ffffff"}; border-color ${step >= 2 ? "#4caf50" : "#00000033"}; line-width 1.5; title ${step > 2 ? "" : "2"}; font-size 9; line-height 11; font-family "IBM Plex Sans"; text-color ${step >= 2 ? "#ffffff" : "#00000066"} }
				item label { title ${s2}; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight ${step === 2 ? 600 : 400}; layout left; text-color ${step === 2 ? "#0f121a" : "#00000099"} }
			}
			item step3 { auto-layout row; gap 8; align center; width fill; height 32; clip yes
				item dot { width 16; height 16; corner-radius 8; color ${step > 3 ? "#4caf50" : "#ffffff"}; border-color ${step >= 3 ? "#4caf50" : "#00000033"}; line-width 1.5; title ${step > 3 ? "" : "3"}; font-size 9; line-height 11; font-family "IBM Plex Sans"; text-color ${step >= 3 ? "#ffffff" : "#00000066"} }
				item label { title "3. Задачи"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight ${step === 3 ? 600 : 400}; layout left; text-color ${step === 3 ? "#0f121a" : "#00000099"} }
			}
			item step4 { auto-layout row; gap 8; align center; width fill; height 32; clip yes
				item dot { width 16; height 16; corner-radius 8; color ${step > 4 ? "#4caf50" : "#ffffff"}; border-color ${step >= 4 ? "#4caf50" : "#00000033"}; line-width 1.5; title ${step > 4 ? "" : "4"}; font-size 9; line-height 11; font-family "IBM Plex Sans"; text-color ${step >= 4 ? "#ffffff" : "#00000066"} }
				item label { title "4. Workflow"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight ${step === 4 ? 600 : 400}; layout left; text-color ${step === 4 ? "#0f121a" : "#00000099"} }
			}
			item step5 { auto-layout row; gap 8; align center; width fill; height 32; clip yes
				item dot { width 16; height 16; corner-radius 8; color ${step > 5 ? "#4caf50" : "#ffffff"}; border-color ${step >= 5 ? "#4caf50" : "#00000033"}; line-width 1.5; title ${step > 5 ? "" : "5"}; font-size 9; line-height 11; font-family "IBM Plex Sans"; text-color ${step >= 5 ? "#ffffff" : "#00000066"} }
				item label { title "5. Сводка"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight ${step === 5 ? 600 : 400}; layout left; text-color ${step === 5 ? "#0f121a" : "#00000099"} }
			}
			item step6 { auto-layout row; gap 8; align center; width fill; height 32; clip yes; hidden ${count < 6}
				item dot { width 16; height 16; corner-radius 8; color ${step > 6 ? "#4caf50" : "#ffffff"}; border-color ${step >= 6 ? "#4caf50" : "#00000033"}; line-width 1.5; title ${step > 6 ? "" : "6"}; font-size 9; line-height 11; font-family "IBM Plex Sans"; text-color ${step >= 6 ? "#ffffff" : "#00000066"} }
				item label { title "6. Сводка"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight ${step === 6 ? 600 : 400}; layout left; text-color ${step === 6 ? "#0f121a" : "#00000099"} }
			}
		}
		item body { auto-layout column; gap 16; padding 24; width fill; height fill; clip yes
			slot body { item hint { title ""; font-size 1 } }
		}
	}
	item footer {
		auto-layout row; gap 8; padding 12 24; align center; justify space-between; width fill; height 64; clip yes; border-color #0000000f
		use Libraries.ui_kit.Actions.ClassicButton as Back {
			kind regular; size large; label "Back"
			replace icon_kit_Plus {
				use Libraries.ui_kit.Icon.chevronL as "icon/chevronL" { border-color #0f121a; line-width 1 }
			}
		}
		item nav {
			auto-layout row; gap 8; align center; clip yes
			use Libraries.ui_kit.Actions.ClassicButton as Next {
				kind primary; size large; label "Next"
				replace icon_kit_Plus {
					use Libraries.ui_kit.Icon.chevronR as "icon/chevronR" { border-color #ffffff; line-width 1 }
				}
			}
			use Libraries.ui_kit.Actions.ClassicButton as Submit {
				kind regular; size large; label Создать
			}
		}
	}
	pos 792 -1237
}


item CPStepBasics {
	export let based = false; export let name = Сайт; export let id = WEB; export let prefix = "WEB-1"; export let idError = false; export let withBase = false
	auto-layout column; gap 16; width 528; clip yes
	item "Способ создания" {
		auto-layout column; gap 8; width fill; clip yes
		item label { title "Способ создания"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
		item seg {
			auto-layout row; gap 0; clip yes; color #f2f2f4; corner-radius 6
			item "Пустой проект" { title "Пустой проект"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; padding 6 12; color ${based === "true" ? "none" : "#6b3ad31a"}; corner-radius 6; border-color ${based === "true" ? "none" : "#6b3ad3"}; text-color ${based === "true" ? "#00000099" : "#6b3ad3"} }
			item "На основе проекта" { title "На основе проекта"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; padding 6 12; color ${based === "true" ? "#6b3ad31a" : "none"}; corner-radius 6; border-color ${based === "true" ? "#6b3ad3" : "none"}; text-color ${based === "true" ? "#6b3ad3" : "#00000099"} }
		}
	}
	item "Проект-основа" {
		auto-layout row; gap 16; align center; width fill; clip yes; hidden ${withBase !== "true"}
		item labels {
			auto-layout column; gap 2; width 200; clip yes
			item label { title "Проект-основа"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			item hint { title "Активный или архивный проект"; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
		}
		use Libraries.ui_kit.Forms.SelectButton as "Select/Основа" {
			label "Сайт 2025  Архив"; chevron true; width 370
		}
	}
	item "Тип проекта" {
		auto-layout row; gap 16; align center; width fill; clip yes
		item labels {
			auto-layout column; gap 2; width 200; clip yes
			item label { title "Тип проекта"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			item hint { title "Статусы и типы задач берутся из типа проекта"; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #00000066; hidden ${based === "true"} }
			item hint2 { title "Берется из проекта-основы, изменить нельзя"; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #00000066; hidden ${based !== "true"} }
		}
		use Libraries.ui_kit.Forms.SelectButton as "Select/Тип проекта" {
			label Default; chevron true; width 370; disabled ${based}
		}
	}
	item Название {
		auto-layout row; gap 16; align center; width fill; clip yes
		item labels {
			auto-layout column; gap 2; width 200; clip yes
			item label { title Название; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
		}
		item "Input/Название" {
			auto-layout row; gap 8; padding 0 10; align center; width 370; height 32; clip yes; color #1530720d; border-color #1530720d; corner-radius 6
			item Value { title ${name}; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; width fill; text-color #0f121a }
		}
	}
	item Идентификатор {
		auto-layout row; gap 16; align center; width fill; clip yes
		item labels {
			auto-layout column; gap 2; width 200; clip yes
			item label { title Идентификатор; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			item hint { title "Префикс номеров задач: ${prefix}"; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
			item error { title "Идентификатор уже существует"; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #e2a23d; hidden ${idError !== "true"} }
		}
		item "Input/Идентификатор" {
			auto-layout row; gap 8; padding 0 10; align center; width 370; height 32; clip yes; color #1530720d; border-color ${idError === "true" ? "#eb5757" : "#1530720d"}; corner-radius 6
			item Value { title ${id}; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; width fill; text-color #0f121a }
		}
	}
	item Описание {
		auto-layout row; gap 16; align start; width fill; clip yes
		item labels {
			auto-layout column; gap 2; width 200; clip yes
			item label { title Описание; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			item hint { title "Подставлено из проекта-основы"; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #00000066; hidden ${based !== "true"} }
		}
		item "Input/Описание" {
			auto-layout row; gap 8; padding 0 10; align start; width 370; height 56; clip yes; color #1530720d; border-color #1530720d; corner-radius 6
			item Value { title "Корпоративный сайт компании: каталог услуг, блог и форма обратной связи."; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; width fill; text-color #0f121a }
		}
	}
	item Иконка {
		auto-layout row; gap 16; align center; width fill; clip yes
		item labels {
			auto-layout column; gap 2; width 200; clip yes
			item label { title Иконка; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			item hint { title "Подставлена из проекта-основы"; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #00000066; hidden ${based !== "true"} }
		}
		item icon {
			auto-layout row; gap 8; padding 0 10; align center; width 32; height 32; clip yes; color #ffffff; border-color #6b3ad3; corner-radius 6
			use Libraries.ui_kit.Icon.kit_Building as "icon/kit/Building" { color #6b3ad3 }
		}
	}
	pos 1026 -1327
}

element "Board dark" {
	use Theme as skin {
		theme Dark
		slot content {
			use Libraries.workbench.Workbench as "Board dark screen" {
				pos 0 0
				replace Top_bar {
					use Libraries.workbench.TopBar as "Top bar" {
						at tabs.tab.Tracker { title "Мобильное приложение" }
					}
				}
				slot Main_panel {
					use Libraries.workbench.SpaceHeader as "Space header" {
						width 1515
						at Header_row { width 1481 }
						at divider { width 1481 }
						at Filter_row { width 1481 }
						at divider_2 { width 1513 }
						slot left {
							use Libraries.ui_kit.Actions.Switcher as ViewletSelector {
								slot content {
									item "element kit/BulletList" {
										auto-layout row; align center; justify center; width 32; height 32; clip yes; corner-radius 6
										use Libraries.ui_kit.Icon.kit_BulletList as "icon/kit/BulletList" { color #c1c9d6 }
									}
									item "element kit/Kanban" {
										auto-layout row; align center; justify center; width 32; height 32; clip yes; color #2a3145; corner-radius 6
										use Libraries.ui_kit.Icon.kit_Kanban as "icon/kit/Kanban" { color #ffffff }
									}
									item "element kit/CircleHalfFill" {
										auto-layout row; align center; justify center; width 32; height 32; clip yes; corner-radius 6
										use Libraries.ui_kit.Icon.kit_CircleHalfFill as "icon/kit/CircleHalfFill" { color #c1c9d6 }
									}
								}
							}
							item "button kit/ArrowUpLines" {
							auto-layout row; align center; justify center; width 32; height 32; clip yes; color #2a3145; border-color #3a4250; corner-radius 6
							use Libraries.ui_kit.Icon.kit_ArrowUpLines as "icon/kit/ArrowUpLines" { color #ffffff }
							}
							item "button kit/SlidersHorizontal" {
							auto-layout row; align center; justify center; width 32; height 32; clip yes; color #2a3145; border-color #3a4250; corner-radius 6
							use Libraries.ui_kit.Icon.kit_SlidersHorizontal as "icon/kit/SlidersHorizontal" { color #ffffff }
							}
							item spacer { auto-layout abs; width 12; height 1; clip yes }
							item Breadcrumb {
								auto-layout row; gap 6; align center; clip yes
								item avatar {
									auto-layout row; align center; justify center; width 24; height 24; clip yes; color #2a3145; corner-radius 4
									use Libraries.ui_kit.Icon.kit_CheckSquare as "icon/kit/CheckSquare" { color #8e99af }
								}
								item Issues { title "Задачи"; font-size 16; line-height 20; font-family "IBM Plex Sans"; font-weight 700; layout left; text-color #8e99af }
							}
						}
						slot right {
							item "button kit/DotsHorizontal" {
							auto-layout row; align center; justify center; width 32; height 32; clip yes; color #2a3145; border-color #3a4250; corner-radius 6
							use Libraries.ui_kit.Icon.kit_DotsHorizontal as "icon/kit/DotsHorizontal" { color #ffffff }
						}
						}
						slot filters {
							item Filter {
							auto-layout row; gap 6; padding 0 12; align center; height 32; clip yes; color #6b3ad31a; border-color #3a4250; corner-radius 6
							use Libraries.ui_kit.Icon.kit_Funnel as "icon/kit/Funnel" { color #ffffff }
							item Filter { title Filter; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #ffffff }
							}
							item Search {
							auto-layout row; align center; justify center; width 32; height 32; clip yes; color #6b3ad31a; border-color #3a4250; corner-radius 6
							use Libraries.ui_kit.Icon.kit_Search as "icon/kit/Search" { color #ffffff }
							}
						}
					}
					item Board {
						auto-layout row; gap 16; padding 24; width 1513; height 870; clip yes; pos 2 -114
						use Libraries.tracker_kit.Kanban.KanbanColumn as "Column Backlog" {
						label Backlog
						pos 0 0
					}
					use Libraries.tracker_kit.Kanban.KanbanColumn as "Column In Progress" {
						pos 336 0
					}
					use Libraries.tracker_kit.Kanban.KanbanColumn as "Column Review" {
						label Review
						tools true
						pos 672 0
					}
					}
				}
			}
		}
	}
}
