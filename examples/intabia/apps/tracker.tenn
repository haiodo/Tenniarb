			item column {
			auto-layout column; width fill; clip yes
				item row { auto-layout row; padding 8 12; align center; width fill; clip yes; border-color #0000000f
				item n { title "Мой спринт"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; width fill }
				}
