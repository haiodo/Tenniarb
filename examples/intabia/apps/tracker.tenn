				item "section" { auto-layout row; padding 8 12 2 12; align center; justify center; width fill; clip yes
				item t { title "МОИ ДОСКИ"; font-size 10; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
				}
