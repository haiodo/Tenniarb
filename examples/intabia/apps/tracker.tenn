						item row {
							auto-layout row; padding 6 12; align center; width fill; clip yes
							item person {
								auto-layout row; gap 8; align center; width fill; clip yes
								use Libraries.ui_kit.People.Avatar as "Avatar/24" {
									width 24; height 24; color #83af12; corner-radius 5
