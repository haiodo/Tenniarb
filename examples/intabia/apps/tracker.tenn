item CreateProjectScreen {
	auto-layout abs; width 1920; height 1080; clip yes
	item scrim { auto-layout abs; width 1920; height 1080; clip yes; color #00000040; pos 0 0 }

	use Libraries.workbench.Workbench as Workbench {
			replace _Navigator {
				use Libraries.workbench.Navigator as Navigator {
					pos 68 -36
					slot items {
					use Libraries.workbench.NavItem as "NavItem/My issues" {
						pos 13 -112
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.timeline as "icon/timeline" { border-color #0f121a; line-width 1 }
