						at Title { title Колонки }
						at Hint_of_the_section {
							hidden no
							title "Колонка объединяет один или несколько статусов. Перетащите статус в колонку, чтобы задачи в нём появились на доске. Открытые статусы без колонки на доске не видны, закрытые без колонки (Done, Released) уходят с доски по замыслу."
							width 1218
						}
					}
					item options {
						auto-layout row; gap 32; align center; width 1218; height 32; clip yes
						use Libraries.ui_kit.Forms.Toggle as Toggle {
							at Label { title WIP-лимиты }
						}
						use Libraries.ui_kit.Forms.Toggle as Toggle {
							on false
