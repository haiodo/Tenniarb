			item hint {
			auto-layout abs; width 340; height 76; clip yes; color #1f2129; corner-radius 6; pos 720 -760
				item text { title "1. Сегменты у заголовка: \"Задачи\" - этот вид, дальше доски, в которые входит проект (закрепленные первыми). \"+\" - создать доску с этим проектом. Клик по доске открывает доску (предложение)."; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; padding 8; width fill; text-color #ffffff }
			}
		}
