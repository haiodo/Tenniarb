				item n { title "Основная доска"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; width fill }
				item p { title "APP·MKT"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
