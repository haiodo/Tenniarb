element CreateProject {
	use CreateProjectScreen as Screen {
		slot dialog {
			use CreateProjectWizard as "Создание проекта - Шаг 1. Основное" {
				step 1; pos 564 -278
		slot body {
			item "Способ создания" {
				auto-layout column; gap 8; width fill; clip yes
				item label { title "Способ создания"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
				item seg {
					auto-layout row; gap 0; clip yes; color #f2f2f4; corner-radius 6
					item "Пустой проект" { title "Пустой проект"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; padding 6 12; color #6b3ad31a; corner-radius 6; border-color #6b3ad3; text-color #6b3ad3 }
					item "На основе проекта" { title "На основе проекта"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; padding 6 12; text-color #00000099 }
				}
			}
			item "Тип проекта" {
				auto-layout row; gap 16; align center; width fill; clip yes
				item labels {
					auto-layout column; gap 2; width 200; clip yes
					item label { title "Тип проекта"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
					item hint { title "Статусы и типы задач берутся из типа проекта"; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
				}
				use Libraries.ui_kit.Forms.SelectButton as "Select/Тип проекта" {
					label Default; chevron true; width 370
				}
			}
			item Название {
				auto-layout row; gap 16; align center; width fill; clip yes
				item labels {
					auto-layout column; gap 2; width 200; clip yes
					item label { title Название; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
				}
				item "Input/Название" {
					auto-layout row; gap 8; padding 0 10; align center; width 370; height 32; clip yes; color #1530720d; border-color #1530720d; corner-radius 6
					item Value { title Сайт; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; width fill; text-color #0f121a }
				}
			}
			item Идентификатор {
				auto-layout row; gap 16; align center; width fill; clip yes
				item labels {
					auto-layout column; gap 2; width 200; clip yes
					item label { title Идентификатор; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
					item hint { title "Префикс номеров задач: WEB-1"; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
				}
				item "Input/Идентификатор" {
					auto-layout row; gap 8; padding 0 10; align center; width 370; height 32; clip yes; color #1530720d; border-color #1530720d; corner-radius 6
				item Value { title WEB; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; width fill; text-color #0f121a }
				}
			}
			item Описание {
				auto-layout row; gap 16; align start; width fill; clip yes
				item labels {
					auto-layout column; gap 2; width 200; clip yes
					item label { title Описание; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
				}
				item "Input/Описание" {
				auto-layout row; gap 8; padding 0 10; align start; width 370; height 56; clip yes; color #1530720d; border-color #1530720d; corner-radius 6
					item Value { title "Корпоративный сайт компании: каталог услуг, блог и форма обратной связи."; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; width fill; text-color #0f121a }
				}
			}
			item Иконка {
				auto-layout row; gap 16; align center; width fill; clip yes
				item labels {
					auto-layout column; gap 2; width 200; clip yes
					item label { title Иконка; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
				}
				item icon {
				auto-layout row; gap 8; padding 0 10; align center; width 32; height 32; clip yes; color #ffffff; border-color #6b3ad3; corner-radius 6
				use Libraries.ui_kit.Icon.kit_Building as "icon/kit/Building" { color #6b3ad3 }
				}
			}
			}
			}
		}
	}
	use CreateProjectScreen as "Screen/2" {
		pos 2040 0
		slot dialog {
			use CreateProjectWizard as "Создание проекта - Шаг 1. Ошибка идентификатора" {
				step 1; pos 564 -278
				slot body {
					use CPStepBasics as Basics { id APP; prefix "APP-1"; idError true }
				}
			}
		}
	}
	use CreateProjectScreen as "Screen/3" {
		pos 0 -1200
		slot dialog {
			use CreateProjectWizard as "Создание проекта - Шаг 2. Участники и доступ" {
				step 2; pos 564 -278
				slot body {
					item "Приватный проект" {
						auto-layout row; gap 16; align center; width fill; clip yes
						item labels {
							auto-layout column; gap 2; width fill; clip yes
							item label { title "Приватный проект"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
							item hint { title "Видят только участники"; font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
						}
						use Libraries.ui_kit.Forms.Toggle as Toggle {
							on true
							at Label { hidden yes }
						}
					}
					item "members head" {
						auto-layout row; align center; justify space-between; width fill; height 32; clip yes
						item "Участники · 3" { title "Участники · 3"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left }
						use Libraries.ui_kit.Actions.Button as "Button/secondary/small" {
							kind secondary; size small
							replace icon_kit_Plus {
								use Libraries.ui_kit.Icon.plus as "icon/plus" { border-color #000000; line-width 1 }
							}
							at Button { title "Добавить участника" }
						}
					item "members rows" {
						auto-layout column; width fill; clip yes
						item head {
							auto-layout row; padding 0 12; align center; width fill; height 36; clip yes
							item Сотрудник { title Сотрудник; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099; width fill }
							item Роль { title Роль; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099; width 160 }
							item spacer { width 28; height 1 }
						}
					item divider { auto-layout abs; width fill; height 1; clip yes; color #0000000f }
					item row {
					auto-layout row; padding 6 12; align center; width fill; clip yes
					item person {
					auto-layout row; gap 8; align center; width fill; clip yes
					use Libraries.ui_kit.People.Avatar as "Avatar/24" {
					width 24; height 24; color #4ca6ee; corner-radius 5
					at initials { title СА; font-size 10; line-height 13 }
					}
					item "Анна Смирнова" { title "Анна Смирнова"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
					}
					use Libraries.ui_kit.Forms.SelectButton as "Роль/Владелец" {
					label Владелец; chevron true; width 160; field true
					}
					item spacer { width 28; height 1 }
					}
					item divider { auto-layout abs; width fill; height 1; clip yes; color #0000000f }
					item row {
					auto-layout row; padding 6 12; align center; width fill; clip yes
					item person {
					auto-layout row; gap 8; align center; width fill; clip yes
					use Libraries.ui_kit.People.Avatar as "Avatar/24" {
					width 24; height 24; color #83af12; corner-radius 5
					at initials { title КМ; font-size 10; line-height 13 }
					}
					item "Мария Козлова" { title "Мария Козлова"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
					}
					use Libraries.ui_kit.Forms.SelectButton as "Роль/Участник" {
					label Участник; chevron true; width 160; field true
					}
					item spacer { width 28; height 1 }
					}
					item divider { auto-layout abs; width fill; height 1; clip yes; color #0000000f }
					item row {
					auto-layout row; padding 6 12; align center; width fill; clip yes
					item person {
					auto-layout row; gap 8; align center; width fill; clip yes
					use Libraries.ui_kit.People.Avatar as "Avatar/24" {
					width 24; height 24; color #db877d; corner-radius 5
					at initials { title ПИ; font-size 10; line-height 13 }
					}
					item "Иван Петров" { title "Иван Петров"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
					}
					use Libraries.ui_kit.Forms.SelectButton as "Роль/Участник 2" {
					label Участник; chevron true; width 160; field true
					}
					item spacer { width 28; height 1 }
					}
				}
					}
				}
			}
		}
	}
	use CreateProjectScreen as "Screen/4" {
		pos 2040 -1200
		slot dialog {
			use CreateProjectWizard as "Создание проекта - Шаг 3. Задачи" {
				step 3; pos 564 -278
				slot body {
					item "Исполнитель по умолчанию" {
						auto-layout row; gap 16; align center; width fill; clip yes
						item labels {
							auto-layout column; gap 2; width 200; clip yes
