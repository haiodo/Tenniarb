element Issue {
	use Libraries.workbench.Workbench as "Issue page" {
		pos 0 0
		replace _Navigator {
			use Libraries.workbench.Navigator as Navigator {
				pos 68 -36
				slot items {
					use Libraries.workbench.NavItem as "NavItem/My issues" {
						pos 13 -112
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.kit_Crosshair as "icon/kit/Crosshair" { color #0f121a }
						}
						at Issues { title "My issues" }
					}
					use Libraries.workbench.NavItem as "NavItem/All issues" {
						pos 13 -144
						at Issues { title "All issues" }
					}
					item divider { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -188 }
					use Libraries.workbench.NavItem as "NavItem/All projects" {
						pos 13 -201
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.kit_BulletList as "icon/kit/BulletList" { color #0f121a }
						}
						at Issues { title "All projects" }
					}
					use Libraries.workbench.NavItem as "NavItem/Labels" {
						pos 13 -233
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.kit_Tags as "icon/kit/Tags" { color #0f121a }
						}
						at Issues { title Labels }
					}
					item divider { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -277 }
					use Libraries.workbench.NavGroup as "NavGroup Your projects" { pos 0 -277 }
					use Libraries.workbench.NavSpace as "NavSpace Mobile App" { pos 0 -322 }
					use Libraries.workbench.NavItem as "NavItem/Issues" { selected true; padding 0 8 0 32; pos 13 -358 }
					use Libraries.workbench.NavItem as "NavItem/Components" {
						padding 0 8 0 32; pos 13 -390
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.kit_Diamond as "icon/kit/Diamond" { color #0f121a }
						}
						at Issues { title Components }
					}
					use Libraries.workbench.NavItem as "NavItem/Milestones" {
						padding 0 8 0 32; pos 13 -422
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.kit_Signpost as "icon/kit/Signpost" { color #0f121a }
						}
						at Issues { title Milestones }
					}
					use Libraries.workbench.NavItem as "NavItem/Templates" {
						padding 0 8 0 32; pos 13 -454
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.kit_Layout as "icon/kit/Layout" { color #0f121a }
						}
						at Issues { title Templates }
					}
					item "footer line" { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -494 }
				}
			}
		}
		slot Main_panel {
			use Libraries.tracker_kit.Page.IssuePage as "Issue page APP-3" {
				height 1044; pos 1 -1
				slot content {
					item "button kit/Cross" {
						auto-layout row; align center; justify center; width 32; height 32; clip yes; corner-radius 6; pos 17 -12
						use Libraries.ui_kit.Icon.kit_Cross as "icon/kit/Cross" { width 20; height 20; color #5a667e }
					}
					item divider { auto-layout abs; width 1; height 32; clip yes; color #0000000f; pos 61 -12 }
					item "button kit/Sparkle" {
						auto-layout row; align center; justify center; width 32; height 32; clip yes; corner-radius 6; pos 1245 -12
						use Libraries.ui_kit.Icon.kit_Sparkle as "icon/kit/Sparkle" { width 20; height 20; color #5a667e }
					}
					item reactions {
						auto-layout row; align center; justify center; width 36; height 32; clip yes; pos 1285 -12
						use Libraries.ui_kit.Icon.kit_Star as "icon/kit/Star" { width 20; height 20; color #5a667e }
					}
					item "button kit/Link" {
						auto-layout row; align center; justify center; width 32; height 32; clip yes; corner-radius 6; pos 1329 -12
						use Libraries.ui_kit.Icon.kit_Link as "icon/kit/Link" { width 20; height 20; color #5a667e }
					}
					item "button kit/ArrowInSquare" {
						auto-layout row; align center; justify center; width 32; height 32; clip yes; corner-radius 6; pos 1369 -12
						use Libraries.ui_kit.Icon.kit_ArrowInSquare as "icon/kit/ArrowInSquare" { width 20; height 20; color #5a667e }
					}
					item "button kit/DotsHorizontal" {
						auto-layout row; align center; justify center; width 32; height 32; clip yes; corner-radius 6; pos 1409 -12
						use Libraries.ui_kit.Icon.kit_DotsHorizontal as "icon/kit/DotsHorizontal" { width 20; height 20; color #5a667e }
					}
					item "aside divider" { auto-layout abs; width 1; height 20; clip yes; color #1530721a; pos 1453 -18 }
					item "button kit/ArrowInSquare" {
						auto-layout row; align center; justify center; width 32; height 32; clip yes; color #6b3ad31a; corner-radius 6; pos 1466 -12
						use Libraries.ui_kit.Icon.kit_ArrowInSquare as "icon/kit/ArrowInSquare" { width 20; height 20; color #cf13a2 }
					}
					item "header border" { auto-layout abs; width 1513; height 1; clip yes; color #0000000f; pos 1 -56 }
					item separator { auto-layout abs; width 1; height 986; clip yes; color #0000000f; pos 1113 -57 }
					item "button kit/ArrowsOutLineHorizontal" {
						auto-layout row; align center; justify center; width 32; height 32; clip yes; corner-radius 6; pos 1067 -89
						use Libraries.ui_kit.Icon.kit_ArrowsOutLineHorizontal as "icon/kit/ArrowsOutLineHorizontal" { width 20; height 20; color #5a667e }
					}
					item title {
						title "Push notifications for order status"; font-size 20; line-height 25; font-family "IBM Plex Sans"; layout left; auto-layout row; pos 61 -89
