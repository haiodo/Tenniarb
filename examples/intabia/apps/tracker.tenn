							density normal; width 278
							at top.left.id { title APP-5 }
							replace top.Avatar_20 {
								use Libraries.ui_kit.People.Avatar as "Avatar/empty" { empty true }
							}
							replace title_row.StatusIcon_active {
								item "StatusIcon/backlog" {
									auto-layout abs; width 16; height 16
									item ring {
										width 16; height 16
										path "M8.00 1.00A7 7 0 0 1 8.55 1.02M12.11 2.34A7 7 0 0 1 12.55 2.68M14.66 5.84A7 7 0 0 1 14.81 6.37M14.66 10.16A7 7 0 0 1 14.46 10.68M12.11 13.66A7 7 0 0 1 11.65 13.97M8.00 15.00A7 7 0 0 1 7.45 14.98M3.89 13.66A7 7 0 0 1 3.45 13.32M1.34 10.16A7 7 0 0 1 1.19 9.63M1.34 5.84A7 7 0 0 1 1.54 5.32M3.89 2.34A7 7 0 0 1 4.35 2.03"
										view-box 0 0 16 16; border-color #a1a1a1; line-width 1.5
									}
								}
							}
							at title_row.title { title "Offline mode for product catalog" }
							at chips { width 248 }
							slot chips {
								item priority {
									auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
									use Libraries.ui_kit.Status.PriorityIcon as "Status/PriorityIcon/medium" { priority medium }
								}
							}
						}
					}
				}
				use Libraries.tracker_kit.Kanban.KanbanColumn as "Column Todo" {
					height 898
					replace ColumnHeader_In_Progress {
						use Libraries.tracker_kit.Kanban.ColumnHeader as "ColumnHeader Todo" {
							padding 0 8 0 20; color #d8dbe1
							replace title.Status_StatusIcon_active {
								use Libraries.ui_kit.Status.StatusIcon as "Status/StatusIcon/todo" { category todo }
							}
							at title.In_Progress { title Todo; text-color #5d6b79 }
							at title._6 { title "5" }
