item ButtonGroup {
	export let first = List; export let second = Board; export let third = ""; export let selected = List
	export let kind = secondary; export let size = medium; export let iconOnly = false
	auto-layout row; clip yes; color ${kind === "secondary" ? ctx.surfaceTint : "none"}; border-color ${kind === "secondary" ? ctx.borderField : "none"}; corner-radius 6; use-style ${size}; pos 960 -938
	styles {
		kind one-of secondary ghost
		size one-of large medium small extra-small
		large { first { height 36 }; second { height 36 }; third { height 36 } }
		small { first { height 28 }; second { height 28 }; third { height 28 } }
		extra-small { first { height 24 }; second { height 24 }; third { height 24 } }
	}
	item first {
		auto-layout row; gap 6; padding 0 10; align center; height 32; clip yes; color ${selected === first ? ctx.accentTint : "none"}
		use Icon.kit_BulletList as "icon/kit/BulletList" { width 14; height 14; color #00000099 }
		item Label { title ${first}; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color ${selected === first ? ctx.accentInk : ctx.onFill60}; hidden ${iconOnly === "true"} }
	}
	item second {
		auto-layout row; gap 6; padding 0 10; align center; height 32; clip yes; color ${selected === second ? ctx.accentTint : "none"}
		use Icon.kit_Kanban as "icon/kit/Kanban" { width 14; height 14; color #00000099 }
		item Label { title ${second}; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color ${selected === second ? ctx.accentInk : ctx.onFill60}; hidden ${iconOnly === "true"} }
	}
	item third {
		auto-layout row; gap 6; padding 0 10; align center; height 32; clip yes; color ${selected === third ? ctx.accentTint : "none"}; hidden ${third === ""}
		item Label { title ${third}; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color ${selected === third ? ctx.accentInk : ctx.onFill60} }
	}
}
use Tabs as "Tabs/icons" { icons true; selected Issues; pos 24 -988 }
use SegmentedControl as "SegmentedControl/badge" { first Monthly; second Yearly; third ""; badge "-20%"; selected Yearly; pos 492 -988 }
use ButtonGroup as "ButtonGroup/icons" { iconOnly true; selected Board; pos 960 -988 }

item "§ WizardBar" {
	auto-layout abs; width 300; height 400; color #ffffff; border-color #0000000f; corner-radius 8; pos 0 -1088
	item title { title WizardBar; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ Dialog" {
	auto-layout abs; width 560; height 520; color #ffffff; border-color #0000000f; corner-radius 8; pos 348 -1088
	item title { title Dialog; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ WizardDialog" {
	auto-layout abs; width 944; height 680; color #ffffff; border-color #0000000f; corner-radius 8; pos 956 -1088
	item title { title WizardDialog; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ KitWizardDialog" {
	auto-layout abs; width 768; height 680; color #ffffff; border-color #0000000f; corner-radius 8; pos 348 -1838
	item title { title "WizardDialog product"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item WizardBar {
	export let first = Basics; export let second = "Members and access"; export let third = Issues; export let fourth = Workflow
	export let count = 4; export let step = 1
	auto-layout column; gap 8; width 184; clip yes; pos 24 -1138
	item first {
		auto-layout row; gap 8; align center; width fill; height 32; clip yes; color ${step === 1 ? ctx.accentTint : "none"}; corner-radius 6
		item Number { title "1"; font-size 12; line-height 16; font-family "IBM Plex Sans"; layout left; text-color ${step === 1 ? ctx.accentInk : ctx.inkCaption} }
		item Label { title ${first}; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color ${step === 1 ? ctx.accentInk : ctx.onFill80} }
	}
	item second {
		auto-layout row; gap 8; align center; width fill; height 32; clip yes; color ${step === 2 ? ctx.accentTint : "none"}; corner-radius 6; hidden ${count < 2}
		item Number { title "2"; font-size 12; line-height 16; font-family "IBM Plex Sans"; layout left; text-color ${step === 2 ? ctx.accentInk : ctx.inkCaption} }
		item Label { title ${second}; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color ${step === 2 ? ctx.accentInk : ctx.onFill80} }
	}
	item third {
		auto-layout row; gap 8; align center; width fill; height 32; clip yes; color ${step === 3 ? ctx.accentTint : "none"}; corner-radius 6; hidden ${count < 3}
		item Number { title "3"; font-size 12; line-height 16; font-family "IBM Plex Sans"; layout left; text-color ${step === 3 ? ctx.accentInk : ctx.inkCaption} }
		item Label { title ${third}; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color ${step === 3 ? ctx.accentInk : ctx.onFill80} }
	}
	item fourth {
		auto-layout row; gap 8; align center; width fill; height 32; clip yes; color ${step === 4 ? ctx.accentTint : "none"}; corner-radius 6; hidden ${count < 4}
		item Number { title "4"; font-size 12; line-height 16; font-family "IBM Plex Sans"; layout left; text-color ${step === 4 ? ctx.accentInk : ctx.inkCaption} }
		item Label { title ${fourth}; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color ${step === 4 ? ctx.accentInk : ctx.onFill80} }
	}
}
item Dialog {
	export let title = "Archive channel"; export let width = 480; export let submitLabel = Archive; export let cancelLabel = Cancel
	export let canSubmit = true; export let submitKind = primary; export let footer = true
	auto-layout column; width ${width}; clip yes; color ${ctx.popover}; border-color ${ctx.borderField}; corner-radius 16; shadow 0 -24 24 #0e131e1f; pos 372 -1138
	item header {
		auto-layout row; padding 0 20; align center; justify space-between; width fill; height 56; clip yes
		item Title { title ${title}; font-size 16; line-height 20; font-family "IBM Plex Sans"; font-weight 500; layout left }
		use Button as Close { kind tertiary; size small; shape icon; replace icon_gear { use Icon.x as "icon/x" { border-color #6b3ad3; line-width 1 } } }
	}
	item divider { width fill; height 1; color ${ctx.divider} }
	item body {
		auto-layout column; padding 20; width fill; clip yes
		slot body { item Text { title "Members keep the history, new messages cannot be posted."; font-size 14; line-height 20; font-family "IBM Plex Sans"; layout left; width fill } }
	}
	item footer {
		auto-layout row; gap 8; padding 12 20; align center; justify end; width fill; clip yes; hidden ${footer !== "true"}
		use Button as Cancel { kind secondary; size medium; at icon_kit_Plus { hidden yes }; label ${cancelLabel} }
		use Button as Submit {
			kind ${submitKind}; size medium; state ${canSubmit === "true" ? "default" : "disabled"}
			at icon_kit_Plus { hidden yes }; label ${submitLabel}
		}
	}
}
item WizardDialog {
	export let title = "Create project"; export let width = 896; export let first = Basics; export let second = "Members and access"
	export let third = Issues; export let fourth = Workflow; export let count = 4; export let step = 1
	export let back = Back; export let next = Next; export let submit = Create; export let canProceed = true; export let product = false
	auto-layout column; width ${width}; clip yes; color ${ctx.popover}; border-color ${product === "true" ? "#6b3ad3" : ctx.borderField}; corner-radius 16; shadow 0 -24 24 #0e131e1f; pos 980 -1138
	use-style ${step > 1 ? "back" : ""}; use-style ${step === count ? "last" : ""}
	styles {
		back { Back { hidden no } }
		last { Next { hidden yes }; Submit { hidden no } }
	}
	item header {
		auto-layout row; padding 0 24; align center; width fill; height 56; clip yes
		item Title { title ${title}; font-size 16; line-height 20; font-family "IBM Plex Sans"; font-weight 500; layout left }
	}
	item divider { width fill; height 1; color ${ctx.divider} }
	item content {
		auto-layout row; width fill; height 496; clip yes
		item side {
			auto-layout column; padding 24 16; width 224; height fill; clip yes; border-color #0000000f
			use WizardBar as Steps { first ${first}; second ${second}; third ${third}; fourth ${fourth}; count ${count}; step ${step}; pos 0 0 }
		}
		item body {
			auto-layout column; gap 16; padding 24; width fill; height fill; clip yes
			slot body { item Hint { title "Fill the project details on this step."; font-size 14; line-height 20; font-family "IBM Plex Sans"; layout left; text-color ${ctx.ink60} } }
		}
	}
	item footer {
		auto-layout row; gap 8; padding 12 24; align center; justify space-between; width fill; height 64; clip yes; border-color #0000000f
		use ClassicButton as Back { kind regular; size large; label ${back}; hidden yes }
		item grow { width fill; height 1 }
		use ClassicButton as Next { kind primary; size large; state ${canProceed === "true" ? "default" : "disabled"}; label ${next} }
		use ClassicButton as Submit { kind primary; size large; label ${submit}; hidden yes }
	}
}
use WizardBar as "WizardBar/step3" { step 3; pos 24 -1314 }
use Dialog as "Dialog/negative" { submitKind negative; canSubmit false; pos 372 -1400 }
use WizardDialog as KitWizardDialog {
	title "Import task types"; width 720; first "Select file"; second "Map statuses"; third Review; fourth ""; count 3; step 2; product true; pos 372 -1888
}
item "Theme dark" {
	context --from-item Dark
	auto-layout column; gap 16; padding 24; width 1400; color #131925; border-color #ffffff0f; corner-radius 8; pos 24 -2620
	item title { title "Dark theme: Actions"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #8e99af }
	item kinds {
		auto-layout row; gap 8; align center; clip yes
		use Button as primary
		use Button as secondary { kind secondary }
		use Button as tertiary { kind tertiary }
		use Button as ghost { kind ghost }
		use Button as negative { kind negative }
		use Button as brand { kind brand }
		use Button as disabled { state disabled }
		use Button as "secondary hover" { kind secondary; state hover }
		use Button as "secondary loading" { kind secondary; state loading }
		use Button as focus { state focus }
	}
	item classic {
		auto-layout row; gap 8; align center; clip yes
		use ClassicButton as regular
		use ClassicButton as "regular disabled" { state disabled }
		use ClassicButton as "classic ghost" { kind ghost }
		use ClassicButton as primary { kind primary }
		use ClassicButton as dangerous { kind dangerous }
	}
}
item "Theme dark pickers" {
	context --from-item Dark
	auto-layout column; gap 16; padding 24; width 1400; color #131925; border-color #ffffff0f; corner-radius 8; pos 23 -2790
	item title { title "Dark theme: Tabs, groups, menu, dialogs"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #8e99af }
	item row1 {
		auto-layout row; gap 24; align center; clip yes
		use Tabs as tabs
		use SegmentedControl as segmented
		use ButtonGroup as group { kind secondary }
		use WizardBar as wizard { count 4; step 2 }
	}
	item row2 {
		auto-layout row; gap 24; align end; clip yes
		use Menu as menu
		use Dialog as dialog { width 420 }
	}
}
item "Theme dark wizard" {
	context --from-item Dark
	auto-layout column; gap 16; padding 24; width 1400; color #131925; border-color #ffffff0f; corner-radius 8; pos 24 -3291
	item title { title "Dark theme: WizardDialog"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #8e99af }
	item row {
		auto-layout row; gap 24; align start; clip yes
		use WizardDialog as wizarddialog { width 720; count 4; step 2 }
	}
}
