item Button {
	export let label = Button; export let kind = primary; export let size = medium; export let shape = default; export let state = default; export let pressed = false; export let menu = false; auto-layout row; gap 8
	padding 0 16; align center; justify center; height 40; clip yes; color #6b3ad3; border-color #1725471a; corner-radius 8
	width ${shape === "icon" ? (size === "large" ? 48 : size === "medium" ? 40 : size === "small" ? 32 : 24) : "hug"}
	use-style ${kind} ${size} ${shape === "icon" ? "icon-only" : ""} ${state === "default" ? "" : state === "hover" || state === "loading" ? kind + "-" + state : state} ${(pressed === "true" && kind === "secondary") ? "pressed" : ""}
	pos 24 -44
	styles {
		kind one-of primary secondary tertiary ghost negative brand; size one-of large medium small extra-small; shape one-of default icon
		state one-of default hover focus disabled loading
		primary {
			color #6b3ad3; border-color #1725471a; text-color #ffffff
		}
		secondary {
			color ${ctx.secondaryFill}; border-color ${ctx.secondaryBorder}; text-color ${ctx.ink}
		}
		tertiary {
			color none; border-color none; text-color #6b3ad3
		}
		ghost {
			color none; border-color none; text-color ${ctx.ink}
		}
		negative {
			color #cb4b42; border-color #d1d5de26; text-color #ffffff
		}
		brand {
			color #cf13a2; border-color none; text-color #ffffff
		}
		large { height 48; gap 8; padding 0 16; corner-radius 8 }
		medium { height 40; gap 8; padding 0 16; corner-radius 8 }
		small { height 32; gap 4; padding 0 8; corner-radius 6 }
		extra-small { height 24; gap 4; padding 0 8; corner-radius 4 }
		icon-only { padding 0 }
		primary-hover { color #562ea9 }
		secondary-hover { color ${ctx.iconTileBorder} }
		tertiary-hover { color ${ctx.iconTileBorder} }
		ghost-hover { color ${ctx.iconTileBorder} }
		negative-hover { color #b34139 }
		brand-hover { color #a60f82 }
		primary-loading {
			color #40237f
			Button { opacity 0.7 }
		}
		secondary-loading {
			color ${ctx.loadingFill}
			Button { opacity ${ctx.loadingOpacity} }
		}
		tertiary-loading {
			color ${ctx.loadingFill}
			Button { opacity ${ctx.loadingOpacity} }
		}
		ghost-loading {
			color ${ctx.loadingFill}
			Button { opacity ${ctx.loadingOpacity} }
		}
		negative-loading {
			color #b34139
			Button { opacity 0.7 }
		}
		brand-loading {
			color #7c0b61
			Button { opacity 0.7 }
		}
		disabled { color ${ctx.disabledFill}; border-color none; text-color ${ctx.disabledInk} }
		focus { border-color #cf13a2; line-width 2 }
		pressed { color #17254726 }
	}
	animation spin {
		from { rotate 0 }
		to { rotate 360 }
	}
	use Icon.kit_Plus as "icon/kit/Plus" { hidden ${shape === "icon" || state === "loading"} }
	item Button { font-size 14; line-height 16; font-family "IBM Plex Sans"; font-weight 500; layout left; title ${label}; hidden ${shape === "icon"} }
	use Icon.chevronD as "icon/chevronD" {
		hidden ${(menu !== "true") || state === "loading"}; width 14; height 14; line-width 1.14
		border-color ${kind === "primary" || kind === "negative" || kind === "brand" ? "#ffffff" : kind === "tertiary" ? "#6b3ad3" : ctx.ink}
	}
	use Icon.gear as "icon/gear" { line-width 1; hidden ${shape !== "icon" || state === "loading"} }
	item spinner {
		width 16; height 16; clip yes
		hidden ${state !== "loading"}; animation spin 1s linear infinite
		item arc {
			width 16; height 16; view-box 0 0 24 24
			color ${kind === "primary" || kind === "brand" || kind === "negative" || kind === "dangerous" ? "#ffffff" : kind === "tertiary" ? "#6b3ad3" : ctx.ink}
			path "M12,1A11,11 0 1 1 1,12L3,12A9,9 0 1 0 12,3Z"
		}
	}
}
