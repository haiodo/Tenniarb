item ClassicButton {
	export let label = Button; export let kind = regular; export let size = medium; export let shape = default; export let state = default; auto-layout row; gap 8
	padding 0 12; align center; justify center; height 32; clip yes; color #6b3ad31a; border-color #00000017; corner-radius 6
	use-style ${kind} ${size} ${shape === "icon" ? "icon-only" : ""} ${state === "default" ? "" : state}; pos 24 -560
	styles {
		kind one-of regular primary dangerous ghost icon; size one-of small medium large; shape one-of default icon; state one-of default focus disabled loading
		regular { color ${ctx.classicFill}; border-color ${ctx.border}; text-color ${ctx.onFill80} }
		primary {
			color #cf13a2; border-color #1725471a; text-color #ffffff
		}
		dangerous {
			color #eb5757; border-color #eb5757; text-color #ffffff
		}
		ghost { color none; border-color none; text-color ${ctx.onFill80} }
		icon { color none; border-color none; text-color ${ctx.onFill80} }
		small { height 28; min-width 28 }
		medium { height 32; min-width 32 }
		large { height 36; min-width 36 }
		icon-only { gap 6; padding 0 }
		loading {
			Button { opacity 0.7 }
		}
		disabled { color ${ctx.disabledFill}; border-color none; text-color ${ctx.disabledInk} }
		focus { border-color #cf13a2; line-width 2 }
	}
	animation spin {
		from { rotate 0 }
		to { rotate 360 }
	}
	use Icon.kit_Plus as "icon/kit/Plus" { hidden ${shape === "icon" || state === "loading"} }
	item Button { font-size 13; line-height 17; font-family "IBM Plex Sans"; layout left; title ${label}; hidden ${shape === "icon"} }
	use Icon.kit_CaretDownFill as "icon/kit/CaretDownFill" { hidden yes; color ${ctx.onFill60} }
	use Icon.kit_PencilLine as "icon/kit/PencilLine" { hidden ${shape !== "icon" || state === "loading"} }
	item spinner {
		width 16; height 16; clip yes
		hidden ${state !== "loading"}; animation spin 1s linear infinite
		item arc {
			width 16; height 16; view-box 0 0 24 24
			color ${kind === "primary" || kind === "brand" || kind === "negative" || kind === "dangerous" ? "#ffffff" : kind === "tertiary" ? "#6b3ad3" : ctx.ink}
			path "M12,1A11,11 0 1 1 1,12L3,12A9,9 0 1 0 12,3Z"
		}
	}
}
