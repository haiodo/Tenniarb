	auto-layout abs; width 134; height 88; color #ffffff; border-color #0000000f; corner-radius 8; pos 942 0
	item title { title Toggle; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ Radio" {
	auto-layout abs; width 114; height 86; color #ffffff; border-color #0000000f; corner-radius 8; pos 1104 0
	item title { title Radio; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ EditBox" {
	auto-layout abs; width 304; height 104; color #ffffff; border-color #0000000f; corner-radius 8; pos 1266 0
	item title { title EditBox; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item Input {
	export let label = Label; export let value = Value; export let placeholder = ""; export let layout = single; export let icon = false; export let menu = false
	export let error = false; export let size = medium; auto-layout column; gap 4
	clip yes; use-style ${layout} ${size} ${(error === "true") ? "error" : ""}; pos 24 -50
	styles {
		layout one-of single multiline
		single { field { height 32; padding 0 10; align center } }
		size one-of narrow medium wide
		narrow { field { width 160 } }
		wide { field { width 420 } }
		error { field { border-color ${ctx.errorBorder} } }
		multiline {
			field {
				height 64; padding 8 10; align start
				Value { width 220 }
			}
		}
	}
	item Label { font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color ${ctx.onFill60}; title ${label}; hidden ${label === ""} }
	item field {
		auto-layout row; gap 6; width 240; clip yes; color ${ctx.fieldSubtle}; border-color ${ctx.fieldSubtle}; corner-radius 6
		use Icon.kit_PersonCircle as "icon/kit/PersonCircle" { color ${ctx.onFill60}; hidden ${!(icon === "true")} }
		item Value { font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color ${(value === "") ? ctx.inkPlaceholder : ctx.ink}; title ${(value === "") ? placeholder : value} }
		item grow { auto-layout abs; width fill; height 1; clip yes; hidden ${!(menu === "true")} }
		use Icon.chevronD as "icon/chevronD" { width 14; height 14; border-color ${ctx.onFill60}; line-width 1.14; hidden ${!(menu === "true")} }
	}
}
item "Input/variants" {
	auto-layout row; gap 16; align end; clip yes; pos 24 -110
	use Input as "Input/narrow" { size narrow; label ""; at field.Value { title APP } }
	use Input as "Input/error" { label ""; error true; at field.Value { title APP } }
	use Input as "Input/placeholder" { label ""; value ""; placeholder Name }
}
item Checkbox {
	export let checked = true; export let indeterminate = false; export let label = Label; export let disabled = false; export let error = false
	export let kind = brand; export let size = medium; export let shape = default; 	auto-layout row; gap 8; align center; clip yes; opacity ${disabled === "true" ? 0.45 : 1}; use-style ${size} ${shape}; pos 804 -44
	styles {
		kind one-of primary brand positive negative neutral
		size one-of medium small
		small { box { width 12; height 12 }; Label { font-size 12; line-height 15 } }
		shape one-of default round
		round { box { corner-radius 8 } }
	}
	item box {
		auto-layout row; align center; justify center; width 16; height 16; clip yes; line-width 0; corner-radius 4
		color ${checked === "true" || indeterminate === "true" ? (kind === "primary" ? "#6b3ad3" : kind === "positive" ? "#05a05c" : kind === "negative" ? "#d15045" : kind === "neutral" ? "#5a667e" : "#cf13a2") : "none"}
		border-color ${error === "true" ? "#e34748" : checked === "true" || indeterminate === "true" ? "none" : ctx.controlBorder}
		use Icon.tick as "icon/tick" { width 12; height 12; border-color #ffffff; line-width 0.98; hidden ${checked !== "true" || indeterminate === "true"} }
		item dash { width 8; height 2; color #ffffff; hidden ${indeterminate !== "true"} }
	}
	item Label { font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; title ${label} }
}
item Toggle {
	export let on = true; export let label = Label; export let description = ""; export let disabled = false
	export let kind = brand; export let size = medium; export let labelPosition = end
	auto-layout row; gap 8; align center; clip yes; opacity ${disabled === "true" ? 0.45 : 1}; use-style ${size}; pos 966 -44
	styles {
		kind one-of brand primary positive negative
		size one-of large medium small extra-small
		large { track { width 44; height 24; corner-radius 12; Ellipse { width 20; height 20; corner-radius 10 } } }
		small { track { width 32; height 18; corner-radius 9; Ellipse { width 14; height 14; corner-radius 7 } } }
		extra-small { track { width 28; height 16; corner-radius 8; Ellipse { width 12; height 12; corner-radius 6 } } }
	}
	item LeadingLabel { font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; title ${label}; body ${description}; hidden ${labelPosition !== "start"} }
	item track {
		auto-layout row; padding 2; align center; width 36; height 20; clip yes; corner-radius 10
		color ${on === "true" ? (kind === "primary" ? "#6b3ad3" : kind === "positive" ? "#05a05c" : kind === "negative" ? "#d15045" : "#cf13a2") : "#78788052"}
		justify ${on === "true" ? "end" : "start"}
		item Ellipse { width 16; height 16; corner-radius 8; color #ffffff; shadow 0 -3 8 #00000026 }
	}
	item Label { font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; title ${label}; body ${description}; hidden ${labelPosition === "start"} }
}
item Radio {
	export let on = true; export let label = Label; export let hint = ""; export let disabled = false
	export let kind = brand; export let size = medium; 	auto-layout row; gap 8; clip yes; opacity ${disabled === "true" ? 0.45 : 1}; use-style ${size}; pos 1148 -44
	styles {
		kind one-of primary brand positive negative
		size one-of medium small
		small { dot { width 12; height 12; corner-radius 6 }; Label { font-size 12; line-height 15 } }
	}
	item dot {
		auto-layout row; align center; justify center; width 16; height 16; clip yes; corner-radius 8
		border-color ${on === "true" ? (kind === "primary" ? "#6b3ad3" : kind === "positive" ? "#05a05c" : kind === "negative" ? "#d15045" : "#cf13a2") : ctx.controlBorder}
		line-width ${on === "true" ? 5 : 1}
	}
	item text {
		auto-layout column; gap 2; clip yes
		item Label { font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; title ${label} }
		item Hint { font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color ${ctx.inkCaption}; title ${hint}; hidden ${hint === ""} }
	}
}
item EditBox {
	export let value = Value; export let kind = ghost-large; export let width = 256; auto-layout row; padding 0 8; align center; height 36; clip yes
	border-color ${ctx.divider}; corner-radius 6; width ${width}; use-style ${kind}; pos 1310 -50
	styles {
		kind one-of ghost-large large-style editbox
		ghost-large {
			height 36; padding 0 8; border-color ${ctx.divider}
			Value { font-size 16; font-weight 500 }
		}
		large-style {
			height 26; padding 0; border-color none
			Value { font-size 20; font-weight 400 }
		}
		editbox {
			height 19; padding 0; border-color none
			Value { font-size 14; font-weight 400 }
		}
	}
	item Value { font-size 16; line-height 21; font-family "IBM Plex Sans"; font-weight 500; layout left; title ${value} }
}

