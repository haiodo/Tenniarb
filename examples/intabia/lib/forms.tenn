item TextInput {
	export let label = ""; export let value = "Mobile app"; export let placeholder = Name; export let icon = false; export let clearable = false
	export let error = false; export let disabled = false; export let heading = false; export let kind = secondary; export let width = 256; 	auto-layout column; gap 4; width ${width}; opacity ${disabled === "true" ? 0.45 : 1}; pos 24 -274
	styles {
		kind one-of primary secondary ghost
		primary { field { color ${ctx.field}; border-color ${ctx.borderField} } }
		secondary { field { color ${ctx.fieldSubtle}; border-color ${ctx.fieldSubtle} } }
		ghost { field { border-color none } }
		heading { field { border-color none }; Value { font-size 20; line-height 25 } }
		error { field { border-color ${ctx.errorBorder} } }
	}
	item Label { title ${label}; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color ${ctx.onFill60}; hidden ${label === ""} }
	item field {
		auto-layout row; gap 8; padding 0 10; align center; width fill; height 32; clip yes; corner-radius 6
		use-style ${heading === "true" ? "heading" : kind}; use-style ${error === "true" ? "error" : ""}
		use Icon.kit_Plus as "icon/kit/Plus" { color ${ctx.onFill60}; hidden ${icon !== "true"} }
		item Value { title ${value === "" ? placeholder : value}; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; width fill; text-color ${value === "" ? ctx.inkPlaceholder : ctx.ink} }
		use Icon.x as "icon/x" { width 12; height 12; border-color ${ctx.inkCaption}; line-width 1; hidden ${clearable !== "true"} }
	}
}
item TextArea {
	export let value = ""; export let placeholder = Description; export let rows = 3; export let error = false; export let disabled = false; export let width = 256; 	auto-layout column; width ${width}; opacity ${disabled === "true" ? 0.45 : 1}; pos 492 -274
	item field {
		auto-layout row; padding 8 10; width fill; height ${rows * 20 + 16}; clip yes; color ${ctx.fieldSubtle}; border-color ${error === "true" ? ctx.errorBorder : ctx.fieldSubtle}; corner-radius 6
		item Value { title ${value === "" ? placeholder : value}; font-size 14; line-height 20; font-family "IBM Plex Sans"; layout left; width fill; text-color ${value === "" ? ctx.inkPlaceholder : ctx.ink} }
	}
}
item SelectButton {
	export let label = "In progress"; export let placeholder = Status; export let icon = false; export let chevron = false
	export let pressed = false; export let disabled = false; export let kind = secondary; export let field = false; export let width = 240; 	auto-layout row; gap 8; padding 0 10; align center; width ${width}; height 32; clip yes; corner-radius 6
	color ${pressed === "true" ? ctx.accentTint : field === "true" ? ctx.fieldSubtle : ctx.field}; border-color ${pressed === "true" ? "#6b3ad3" : kind === "secondary" ? ctx.borderField : "none"}
	opacity ${disabled === "true" ? 0.45 : 1}; pos 960 -274
	styles { kind one-of primary secondary ghost }
	use Icon.kit_Plus as "icon/kit/Plus" { color ${ctx.onFill60}; hidden ${icon !== "true"} }
	item Label { title ${label === "" ? placeholder : label}; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; width fill; text-color ${label === "" ? ctx.inkPlaceholder : ctx.ink} }
	use Icon.chevronD as "icon/chevronD" { width 14; height 14; border-color ${ctx.onFill60}; line-width 1.14; hidden ${chevron !== "true"} }
}
item Dropdown {
	export let values = "In progress"; export let placeholder = Status; export let icon = false; export let chevron = true; export let width = 240; 	auto-layout row; gap 8; padding 0 10; align center; width ${width}; height 32; clip yes; color ${ctx.fieldSubtle}; border-color ${ctx.fieldSubtle}; corner-radius 6; pos 1428 -274
	use Icon.kit_Plus as "icon/kit/Plus" { color ${ctx.onFill60}; hidden ${icon !== "true"} }
	item Value { title ${values === "" ? placeholder : values}; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; width fill; text-color ${values === "" ? ctx.inkPlaceholder : ctx.ink} }
	use Icon.chevronD as "icon/chevronD" { width 14; height 14; border-color ${ctx.onFill60}; line-width 1.14; hidden ${chevron !== "true"} }
}
item SearchInput {
	export let value = ""; export let placeholder = "Find an issue"; export let collapsed = false; export let width = 240; 	auto-layout row; width ${width}; use-style ${collapsed === "true" ? "collapsed" : ""}; pos 1896 -274
	styles {
