use TextInput as "TextInput/error" { label Identifier; value APP; error true; pos 24 -338 }
use TextArea as "TextArea/filled" { value "Long description of the project"; rows 3; pos 492 -370 }
use SelectButton as "SelectButton/pressed" { pressed true; chevron true; pos 960 -344 }
use Dropdown as "Dropdown/multiselect" { values "Alice, Bob"; pos 1428 -344 }
use SearchInput as "SearchInput/collapsed" { collapsed true; pos 1896 -344 }
item "Theme dark" {
	context --from-item Dark
	auto-layout column; gap 16; padding 24; width 1400; color #131925; border-color #ffffff0f; corner-radius 8; pos 24 -560
	item title { title "Dark theme: Forms"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #8e99af }
	item inputs {
		auto-layout row; gap 24; align center; clip yes
		use Input as "input dark" { icon true }
		use Input as "input value" { value "anna@intabia.ru"; menu true }
		use Input as "input error" { error true }
		use Checkbox as "checkbox dark" { kind primary }
		use Checkbox as "checkbox off" { kind primary; checked false }
		use Toggle as "toggle dark" { kind primary }
		use Toggle as "toggle off" { kind primary; on false }
		use Radio as "radio dark" { kind primary }
		use Radio as "radio off" { kind primary; on false; hint "Only visible to you" }
	}
}
item "Theme dark inputs" {
	context --from-item Dark
	auto-layout column; gap 16; padding 24; width 1400; color #131925; border-color #ffffff0f; corner-radius 8; pos 24 -900
	item title { title "Dark theme: Text inputs"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #8e99af }
	item inputs {
		auto-layout row; gap 24; align center; clip yes
		use TextInput as "textinput dark" { label "Name"; icon true }
		use TextInput as "textinput primary" { kind primary; label "Team"; value "Platform" }
		use TextInput as "textinput error" { error true; label "Identifier"; value "APP" }
		use SelectButton as "select dark" { chevron true }
		use SelectButton as "select pressed" { pressed true; chevron true }
	}
	item inputs2 {
		auto-layout row; gap 24; align center; clip yes
		use TextArea as "textarea dark" { value "Long description of the project"; rows 3 }
		use Dropdown as "dropdown dark"
		use SearchInput as "search dark"
		use EditBox as "editbox dark" { value "Quarter plan" }
	}
}
