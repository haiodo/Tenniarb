entry "../PlatformDesign.tenn"
context --from-item Light

item ProfileNavItem {
  export let label = "Раздел"
  export let kind = default
  styles {
    default { color #00000000; text-color ${ctx.inkBody} }
    selected { color ${ctx.navSelectedBg}; text-color ${ctx.navSelectedInk} }
    kind one-of default selected
  }
  auto-layout row; width 216; height 40; padding 0 12; gap 12; align center; corner-radius 6
  use-style ${kind}
  slot icon {
    use Libraries.ui_kit.Icon.kit_Person as Icon { width 16; height 16; color ${ctx.inkIconSoft} }
  }
  item Label { title ${label}; font-size 14; line-height 20; layout left }

  pos 1960 0}

item ProfilePage {
  auto-layout abs; width 1920; height 1080; clip yes
  use Libraries.login_kit.LoginPage as Page {
    pos 0 0
    at Card_slot { hidden yes }
  }
  item Cabinet {
        auto-layout row; width 1180; height 720; pos 370 -180; color ${ctx.card}; corner-radius 12; clip yes; shadow 0 12 40 #00000026
        item Sidebar {
          auto-layout column; width 248; height fill; padding 24 16 20 16; gap 8; color ${ctx.sidebar}
          item Account {
            auto-layout row; width fill; padding 0 8 16 8; gap 12; align center
            use Libraries.ui_kit.People.Avatar as Avatar { width 40; height 40; at initials { title "АС"; font-size 14 } }
            item Account_text {
              auto-layout column; gap 2
              item Name { title "Алекс Смирнов"; font-size 14; font-weight 600; line-height 18; layout left; text-color ${ctx.ink} }
              item Email { title "alex@example.com"; font-size 12; line-height 16; text-color ${ctx.inkHint}; layout left }
            }
          }
          slot navigation {
            use ProfileNavItem as Profile { label "Профиль"}
            use ProfileNavItem as Workspaces { label "Пространства"; slot icon { use Libraries.ui_kit.Icon.kit_Building as Icon { width 16; height 16; color ${ctx.inkIconSoft} } } }
            use ProfileNavItem as Subscriptions { label "Подписки"; slot icon { use Libraries.ui_kit.Icon.kit_Receipt as Icon { width 16; height 16; color ${ctx.inkIconSoft} } } }
            use ProfileNavItem as Security { label "Безопасность"; slot icon { use Libraries.ui_kit.Icon.kit_Key as Icon { width 16; height 16; color ${ctx.inkIconSoft} } } }
          }
          item grow { height fill }
          use ProfileNavItem as Sign_out {
            label "Выйти"
            slot icon { use Libraries.ui_kit.Icon.kit_ArrowOut as Icon { width 16; height 16; color ${ctx.inkIconSoft} } }
          }
        }
        item Main {
          auto-layout column; width fill; height fill
          item Header {
            auto-layout row; width fill; height 88; padding 0 32; gap 16; align center
            slot header {
              item Header_text {
                auto-layout column; gap 4
                item Title { title "Профиль"; font-size 24; font-weight 600; line-height 30; layout left; text-color ${ctx.ink} }
                item Subtitle { title "Публичная информация и настройки аккаунта"; font-size 13; line-height 18; text-color ${ctx.inkHint}; layout left }
              }
            }
          }
          item divider { width fill; height 1; color ${ctx.dividerSoft} }
          item Content {
            auto-layout column; width fill; height fill; padding 28 32; gap 24
            slot content
          }
    }
  }
}

item WorkspaceRow {
  export let name = "Рабочее пространство"
  export let mark = "Р"
  export let role = "Владелец"
  export let visit = "Сегодня"
  auto-layout row; width 800; height 68; padding 0 20; gap 14; align center
  item Mark {
    auto-layout row; width 36; height 36; align center; justify center; color ${ctx.navSelectedBg}; corner-radius 8
    item Letter { title ${mark}; font-size 15; font-weight 600; text-color ${ctx.inkBrandInk} }
  }
  item Name { title ${name}; width fill; font-size 14; font-weight 500; line-height 20; layout left; text-color ${ctx.ink} }
  item Role { title ${role}; width 120; font-size 13; line-height 18; layout left; text-color ${ctx.inkIconSoft} }
  item Visit { title ${visit}; width 150; font-size 13; line-height 18; layout left; text-color ${ctx.inkHint} }
  use Libraries.ui_kit.Icon.kit_ChevronRightLarge as Open { width 16; height 16; color ${ctx.inkHint} }

  pos 1960 120}

item ServiceCard {
  export let title = "Сервис"
  export let description = "Описание сервиса"
  export let status = "Не подключён"
  export let action = "Подключить"
  export let kind = available
  styles {
    available { Status { text-color ${ctx.inkHint} } }
    active { Status { text-color #26815c } }
    kind one-of available active
  }
  auto-layout column; width 800; padding 24; gap 18; color ${ctx.card}; border-color ${ctx.borderFaint}; corner-radius 10
  item Service_head {
    auto-layout row; width fill; gap 16; align center
    item Service_icon {
      auto-layout row; width 44; height 44; align center; justify center; color ${ctx.navSelectedBg}; corner-radius 10
      use Libraries.ui_kit.Icon.kit_CloudTree as Icon { width 22; height 22; color ${ctx.inkBrandInk} }
    }
    item Service_text {
      auto-layout column; width fill; gap 4
      item Title { title ${title}; font-size 17; font-weight 600; line-height 22; layout left; text-color ${ctx.ink} }
      item Status { title ${status}; font-size 12; line-height 16; layout left }
    }
    use Libraries.ui_kit.Actions.Button as Action {
      label ${action}
      kind secondary
      size medium
      at icon_kit_Plus { hidden yes }
    }
  }
  item Description { title ${description}; width fill; font-size 13; line-height 19; layout left; text-color ${ctx.inkIconSoft} }
  slot details
  pos 1960 260
}

item ProfileField {
  export let label = "Поле"
  export let value = "Значение"
  auto-layout row; width 800; min-height 44; padding 10 0; gap 24; align center
  item Label { title ${label}; width 160; font-size 13; line-height 18; layout left; text-color ${ctx.inkHint} }
  item Value { title ${value}; width fill; font-size 14; line-height 20; layout left; text-color ${ctx.ink} }

  pos 1960 460}

item "Theme dark" {
context --from-item Dark
  auto-layout column; gap 16; padding 24; width 860; color #131925; border-color #ffffff0f; corner-radius 8; pos 1960 640
  item title { title "Dark theme: Profile"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #8e99af }
  item examples {
    auto-layout column; gap 12; width 800; clip yes
    use ProfileNavItem as "Profile dark" { label Профиль }
    use ProfileNavItem as "Profile dark selected" { label Профиль; kind selected }
    use WorkspaceRow as "WorkspaceRow dark"
    use ServiceCard as "ServiceCard dark"
    use ServiceCard as "ServiceCard dark active" { kind active; status Подключён; action Настроить }
    use ProfileField as "ProfileField dark"
  }
}
