entry "../PlatformDesign.tenn"
context --from-item Light
item "§ Chip" {
	auto-layout abs; width 161; height 96; color #ffffff; border-color #0000000f; corner-radius 8; pos 0 0
	item title { title Chip; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ Tag" {
	auto-layout abs; width 95; height 88; color #ffffff; border-color #0000000f; corner-radius 8; pos 209 0
	item title { title Tag; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ QuickFilter" {
	auto-layout abs; width 139; height 96; color #ffffff; border-color #0000000f; corner-radius 8; pos 352 0
	item title { title QuickFilter; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ FilterChip" {
	auto-layout abs; width 277; height 96; color #ffffff; border-color #0000000f; corner-radius 8; pos 539 0
	item title { title FilterChip; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ Swatch" {
	auto-layout abs; width 98; height 88; color #ffffff; border-color #0000000f; corner-radius 8; pos 864 0
	item title { title Swatch; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item Chip {
	auto-layout row; gap 4; padding 0 6; align center; height 28; clip yes; color ${ctx.tagSurface}; border-color ${ctx.borderField}; corner-radius 6; pos 24 -44
	slot content {
		use Icon.milestone as "icon/milestone" { width 14; height 14; border-color ${ctx.onFill60}; line-width 1.14 }
		item "Release 1.0" { title "Release 1.0"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
	}
}
item Tag {
	export let label = bug; export let color = #4ca6ee; auto-layout row; gap 4; padding 0 6; align center; height 20; clip yes; border-color ${ctx.borderField}
	corner-radius 10; pos 233 -44
	item Ellipse { width 8; height 8; corner-radius 4; color ${color} }
	item bug { font-size 11; line-height 14; font-family "IBM Plex Sans"; layout left; text-color ${ctx.onFill80}; title ${label} }
}
item QuickFilter {
	export let label = "Only mine"; export let on = false; auto-layout row; padding 0 10; align center; height 28; clip yes; border-color ${ctx.borderField}
	corner-radius 14; use-style ${(on === "true") ? "on" : ""}; pos 376 -44
	styles {
		on { color ${ctx.brandTint}; border-color #cf13a2; text-color #cf13a2 }
	}
	item "Only mine" { font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; title ${label} }
}
item FilterChip {
	export let attribute = Priority; export let operator = in; export let value = "Urgent, High"; auto-layout row; align center; height 28; clip yes
	border-color ${ctx.borderField}; corner-radius 6; pos 563 -44
	item part {
		auto-layout row; padding 0 8; align center; height 28; clip yes; color ${ctx.accentTint}; border-color ${ctx.divider}
		item Priority { font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; title ${attribute}; text-color ${ctx.inkChip} }
	}
	item "part 2" {
		auto-layout row; padding 0 8; align center; height 28; clip yes; color ${ctx.accentTint}; border-color ${ctx.divider}
		item in { font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color ${ctx.onFill60}; title ${operator} }
	}
	item "part 3" {
		auto-layout row; padding 0 8; align center; height 28; clip yes; color ${ctx.accentTint}; border-color ${ctx.divider}
		item "Urgent, High" { font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; title ${value}; text-color ${ctx.inkChip} }
	}
	item remove {
		auto-layout row; align center; justify center; width 26; height 28; clip yes
		use Icon.x as "icon/x" { width 12; height 12; border-color ${ctx.inkCaption}; line-width 0.98 }
	}

	text-color #000000}
item Swatch {
	export let color = #d27540; export let size = 20; auto-layout abs; clip yes; border-color ${ctx.borderSwatch}; corner-radius 4; color ${color}; width ${size}
	height ${size}; pos 888 -44
}

item "§ KitChip" {
	auto-layout abs; width 420; height 170; color #ffffff; border-color #0000000f; corner-radius 8; pos 0 -144
	item title { title "Chip product"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item KitChip {
	export let label = Active; export let kind = default; export let tone = neutral; export let size = medium
	export let color = ""; export let icon = false; export let removable = false; 
	auto-layout row; gap 6; padding 0 10; align center; height 28; clip yes; corner-radius 14
	color ${color === "" ? (tone === "positive" ? "#05a05c1a" : tone === "negative" ? "#d150451a" : tone === "warning" ? "#d298401f" : tone === "info" ? "#3070dc1a" : ctx.fillFaint) : color}
	border-color ${kind === "outline" ? ctx.borderField : "none"}; use-style ${size}; pos 24 -194
	styles {
		kind one-of default outline
		tone one-of neutral positive negative warning info
		size one-of medium small extra-small
		small { height 24; Label { font-size 12; line-height 15 } }
		extra-small { height 20; Label { font-size 11; line-height 14 } }
	}
	use Libraries.ui_kit.Icon.kit_Plus as "icon/kit/Plus" { width 14; height 14; color ${ctx.onFill60}; hidden ${icon !== "true"} }
	item Label { title ${label}; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color ${ctx.ink80} }
	use Libraries.ui_kit.Icon.x as "icon/x" { width 12; height 12; border-color ${ctx.inkCaption}; line-width 1; hidden ${removable !== "true"} }
}
use KitChip as "KitChip/removable" { label "Release 1.0"; tone info; icon true; removable true; pos 24 -264 }
item "Theme dark" {
context --from-item Dark
	auto-layout column; gap 16; padding 24; width 1400; color #131925; border-color #ffffff0f; corner-radius 8; pos 24 -480
	item title { title "Dark theme: Tags and filters"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #8e99af }
	item row1 {
		auto-layout row; gap 12; align center; clip yes
		use Chip as "chip dark"
		use Tag as "tag dark"
		use QuickFilter as "filter off"
		use QuickFilter as "filter on" { on true }
		use FilterChip as "filterchip dark"
		use Swatch as "swatch dark"
	}
	item row2 {
		auto-layout row; gap 12; align center; clip yes
		use KitChip as "kitchip neutral"
		use KitChip as "kitchip positive" { tone positive }
		use KitChip as "kitchip negative" { tone negative }
		use KitChip as "kitchip warning" { tone warning }
		use KitChip as "kitchip info" { tone info; icon true; removable true }
		use KitChip as "kitchip outline" { kind outline }
	}
}
