element "Onboarding" {
    styles {
        item {
            font-size 14
        }
        step {
            color blue-200
        }
        end {
            color green-200
        }
    }
    item "Sign up" {
        use-style step
    }
    item "Verify email" {
        pos 200.0 0.0
        use-style step
    }
    item "Create workspace" {
        pos 413.34475416133273 10.364410427996972
        use-style step
        height 40
    }
    item "Invite team" {
        pos 420.0 -120.0
        use-style step
        body "optional"
    }
    item "First project" {
        pos 640.0 0.0
        use-style end
    }
    item "Email not received" {
        pos 200.0 -120.0
        color red-200
    }
    link "Sign up" "Verify email" {
        display arrow
    }
    link "Verify email" "Create workspace" {
        display arrow
    }
    link "Create workspace" "First project" {
        display arrow
    }
    link "Create workspace" "Invite team" {
        display arrow
        line-style dashed
    }
    link "Invite team" "First project" {
        display arrow
        line-style dashed
    }
    link "Verify email" "Email not received" {
        display arrow
        line-style dotted
    }
}