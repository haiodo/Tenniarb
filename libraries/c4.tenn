element "Person" {
    kind Component
    export let title = "Person"
    export let technology = ""
    export let description = ""
    export let icon = "M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"

    item Box {
        auto-layout column
        gap 3
        align center
        padding 10 14
        width 220
        corner-radius 6
        color #08427B
        item Icon { width 26; height 26; view-box 0 0 24 24; path ${icon}; color #ffffff; hidden ${icon == ""} }
        item Name { title ${title}; font-size 15; font-weight 700; text-color #ffffff }
        item Tech { title ${technology}; font-size 11; font-style italic; text-color #D6E6F5; hidden ${technology == ""} }
        item Desc { title ${description}; font-size 12; text-color #E8F1FA; width fill; hidden ${description == ""} }
        slot body
    }
}

