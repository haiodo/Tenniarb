        export let placeholder = "Search"
        export let disabled = no
        template %{<ToolbarInput defaultValue="${value}" placeholder="${placeholder}"${disabled === "yes" ? " disabled" : ""} />}
        item Box {
            auto-layout row; align center; width 240; height 32; padding 0 10; gap 6; justify space-between
            corner-radius ${ctx.radius}; line-width 1; border-color ${disabled === "yes" ? ctx.line : ctx.lineStrong}
            color ${disabled === "yes" ? ctx.fill : ctx.surface}
            item Value { title ${value}; font-size ${ctx.font}; text-color ${ctx.ink}; hidden ${value === ""} }
            item Placeholder { title ${placeholder}; font-size ${ctx.font}; text-color ${ctx.faint}; hidden ${value !== ""} }
            item Chevron { title ">"; font-size ${ctx.fontSmall}; text-color ${ctx.muted} }
        }
    }

    element "ToolbarLink" {
        kind Component
        context --from-item Wire
        export let text = "Docs"
        export let disabled = no
        template %{<ToolbarLink${disabled === "yes" ? " disabled" : ""}>${text}</ToolbarLink>}
        item Box {
