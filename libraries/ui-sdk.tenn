    }

    element "SegmentedControlItem" {
        kind Component
        context --from-item Wire
        export let text = "Item"
        template %{<SegmentedControlItem>${text}</SegmentedControlItem>}
        item Box {
            auto-layout row; align center; justify center; height 30; padding 0 10
            corner-radius ${ctx.radius}; line-width 1; border-color ${ctx.line}; color ${ctx.surface}
            item Text { title ${text}; font-size ${ctx.font} }
        }
    }

    element "Toggle" {
        kind Component
        context --from-item Wire
        export let text = "Toggle"
        template %{<Toggle>${text}</Toggle>}
        item Box {
            auto-layout row; align center; justify center; height 30; padding 0 10
