    }

    element "ToggleIcon" {
        kind Component
        context --from-item Wire
        template %{<ToggleIcon />}
        item Mark { auto-layout row; width 16; height 16; corner-radius 8; color ${ctx.fillStrong}; border-color ${ctx.line}; line-width 1 }
    }

    element "Toolbar" {
        kind Component
        context --from-item Wire
        template %{<Toolbar>
<slot content/>
</Toolbar>}
        item Box {
            auto-layout row; align center; gap 6; min-height 32; padding 4; corner-radius ${ctx.radius}
            line-width 1; border-color ${ctx.line}; color ${ctx.surface}
            slot content {
                use ToolbarButton as toolbarButton { }
                use ToolbarSeparator as toolbarSeparator { }
                use ToolbarLink as toolbarLink { }
