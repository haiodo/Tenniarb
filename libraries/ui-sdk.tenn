            item s2 { auto-layout row; align center; justify center; height 26; padding 0 10; corner-radius ${ctx.radiusSmall}; item t { title Week; font-size ${ctx.font}; text-color ${ctx.muted} } }
            item s3 { auto-layout row; align center; justify center; height 26; padding 0 10; corner-radius ${ctx.radiusSmall}; item t { title Month; font-size ${ctx.font}; text-color ${ctx.muted} } }
        }
    }

    element "SegmentedControlIndicator" {
        kind Component
        context --from-item Wire
        template %{<SegmentedControlIndicator />}
