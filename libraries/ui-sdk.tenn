// UI SDK wireframe kit: one element per part of the ui-sdk composition tree, grayscale, no behavior.
// The parts are grouped under category elements (Actions, Forms, Display, Overlays, Navigation, Feedback,
// Media); a category carries no kind and no parameters, so the component browser lists it as a group and
// a use names it: `use ui.Forms.Select`. The `template` of an element is the code of its part, so
// `tenniarb generate` prints a screen as @ui-sdk/svelte markup: the template of every use, nested by its
// slots. A part that holds others declares a slot; a composition root fills it with one level of its
// composition, so a bare `use ui.Forms.Select { }` already reads as a select. Every element reads the
// Wire tokens itself: a screen uses a part anywhere, without a wrapper that declares the palette.

item Wire {
    ink #111827; muted #6b7280; faint #9ca3af; line #d1d5db; lineStrong #9ca3af; shade #11182733
    surface #ffffff; fill #f3f4f6; fillStrong #e5e7eb
    onAccent #ffffff; danger #b91c1c
    radius 6; radiusSmall 4; radiusPanel 8; font 13; fontSmall 11; fontTitle 15
}
context --from-item Wire

element "Actions" {
    element "Button" {
        kind Component
        context --from-item Wire
        export let text = "Button"
        export let disabled = no
        template %{<Button${disabled === "yes" ? " disabled" : ""}>${text}</Button>}
        item Box {
            auto-layout row; align center; justify center; width 120; height 32; padding 0 12; gap 6
            corner-radius ${ctx.radius}; line-width 1; border-color ${ctx.line}
            color ${disabled === "yes" ? ctx.fill : ctx.surface}
            item Text { title ${text}; font-size ${ctx.font}; text-color ${disabled === "yes" ? ctx.faint : ctx.ink} }
        }
    }

    element "Pagination" {
        kind Component
        context --from-item Wire
        template %{<Pagination />}
        item Box {
            auto-layout row; align center; gap 4
            item Prev { auto-layout row; align center; justify center; width 30; height 30; corner-radius ${ctx.radius}; border-color ${ctx.line}; line-width 1; item t { title "<"; font-size ${ctx.font} } }
            item p1 { auto-layout row; align center; justify center; width 30; height 30; corner-radius ${ctx.radius}; item t { title 1; font-size ${ctx.font} } }
            item p2 { auto-layout row; align center; justify center; width 30; height 30; corner-radius ${ctx.radius}; color ${ctx.ink}; item t { title 2; font-size ${ctx.font}; text-color ${ctx.onAccent} } }
            item p3 { auto-layout row; align center; justify center; width 30; height 30; corner-radius ${ctx.radius}; item t { title 3; font-size ${ctx.font} } }
            item Next { auto-layout row; align center; justify center; width 30; height 30; corner-radius ${ctx.radius}; border-color ${ctx.line}; line-width 1; item t { title ">"; font-size ${ctx.font} } }
        }
    }

    element "PaginationEllipsis" {
        kind Component
        context --from-item Wire
        export let text = "..."
        template %{<PaginationEllipsis>${text}</PaginationEllipsis>}
        item Text { auto-layout row; title ${text}; font-size ${ctx.font}; text-color ${ctx.ink}; layout left }
    }

    element "PaginationItem" {
        kind Component
        context --from-item Wire
        export let text = "1"
        template %{<PaginationItem>${text}</PaginationItem>}
        item Box {
            auto-layout row; align center; justify center; height 30; padding 0 10
            corner-radius ${ctx.radius}; line-width 1; border-color ${ctx.line}; color ${ctx.surface}
            item Text { title ${text}; font-size ${ctx.font} }
        }
    }

    element "PaginationLink" {
        kind Component
        context --from-item Wire
        export let text = "2"
        export let disabled = no
        template %{<PaginationLink${disabled === "yes" ? " disabled" : ""}>${text}</PaginationLink>}
        item Box {
            auto-layout row; align center; justify center; width 120; height 32; padding 0 12; gap 6
            corner-radius ${ctx.radius}; line-width 1; border-color ${ctx.line}
            color ${disabled === "yes" ? ctx.fill : ctx.surface}
            item Text { title ${text}; font-size ${ctx.font}; text-color ${disabled === "yes" ? ctx.faint : ctx.ink} }
        }
    }

    element "PaginationList" {
        kind Component
        context --from-item Wire
        template %{<PaginationList>
<slot content/>
</PaginationList>}
        item Box {
            auto-layout row; align center; gap 6; min-height 32; padding 4; corner-radius ${ctx.radius}
            line-width 1; border-color ${ctx.line}; color ${ctx.surface}
            slot content {
                item Hint { title "Actions"; font-size 11; text-color ${ctx.faint}; layout left }
            }
        }
    }

    element "PaginationNext" {
        kind Component
        context --from-item Wire
        export let text = ">"
        export let disabled = no
        template %{<PaginationNext${disabled === "yes" ? " disabled" : ""}>${text}</PaginationNext>}
        item Box {
            auto-layout row; align center; justify center; width 120; height 32; padding 0 12; gap 6
            corner-radius ${ctx.radius}; line-width 1; border-color ${ctx.line}
            color ${disabled === "yes" ? ctx.fill : ctx.surface}
            item Text { title ${text}; font-size ${ctx.font}; text-color ${disabled === "yes" ? ctx.faint : ctx.ink} }
        }
    }

    element "PaginationPrevious" {
        kind Component
        context --from-item Wire
        export let text = "<"
        export let disabled = no
        template %{<PaginationPrevious${disabled === "yes" ? " disabled" : ""}>${text}</PaginationPrevious>}
        item Box {
            auto-layout row; align center; justify center; width 120; height 32; padding 0 12; gap 6
