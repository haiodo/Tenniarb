// The body of a classic diagram: every line of the text is a hard break, \n of a string is a newline, the
// text is inset by the 4 points of a title, a list hangs no indent and a word wider than the box is broken
// by characters, as go/render draws it.
element "Body" {
    item Lines {
        pos 0 0
        body %{
line one
line two
line three
}
    }
    item Escaped {
        pos 0 -120
        body "one\ntwo"
    }
    item Wrapped {
        pos 160 0
        width 80
        body "aaaaaa bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb ccc"
    }
    item Narrow {
        pos 320 0
        width 60
        body %{
a word wider than the sixty points of the box
}
    }
    item Expr {
        pos 320 -160
        width 160
        value 41
        title "value ${value}"
        body %{sum ${value + 1}}
    }
    item "Marked" {
        pos 320 -60
        marker "☕️"
        title "with a marker"
    }
    item "Name\nbreaks" {
        pos 320 -260
        width 90
    }
    item List {
        pos 160 -160
        body %{
* first item of the list
* second item, long enough to grow the box a little
}
    }
}
