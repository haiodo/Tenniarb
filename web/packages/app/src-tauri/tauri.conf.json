{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tenniarb",
  "version": "0.1.0",
  "identifier": "andrey.sobolev.tenniarb-tauri",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{ "title": "Untitled", "width": 944, "height": 764 }],
    "security": { "csp": null }
  },
  "plugins": {
    "fs": { "requireLiteralLeadingDot": false }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [{ "ext": ["tenn"], "name": "Tenniarb file", "role": "Editor" }]
  }
}
