{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["packages/*/src", "packages/*/test"],
  "exclude": ["packages/viewer", "packages/embed", "packages/editor", "packages/app", "packages/mindmap"]
}
